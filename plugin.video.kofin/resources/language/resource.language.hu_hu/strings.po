msgstr "Nézővé válás (a csoport ne várjon rám)"

msgctxt "#30581"
msgid "Wait for me again (leave spectator mode)"
msgstr "Várjanak rám újra (kilépés a nézői módból)"

msgctxt "#30582"
msgid "disconnected"
msgstr "lecsatlakozott"

msgctxt "#30583"
msgid "The group will wait for you again"
msgstr "A csoport újra várni fog Önre"

