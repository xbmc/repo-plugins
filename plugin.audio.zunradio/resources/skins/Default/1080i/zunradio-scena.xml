<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZUN radio scene over the whole screen (resources/lib/scena.py), as the full screen player
  on zunradio.cz. Layout in the 1920 x 1080 space shared with visualization.zunradio
  (src/Scena.h): card 514 x 514 centred at 960, 496 with a 22 px red frame.
  Window properties set by scena.py: vis, cover, artist, title, label, labellogo, heading, show,
  small_artist, small_title.
  The pulse of the basses comes from the visualisation as its active preset (Visualisation.Preset,
  visualization.zunradio/src/Scena.h): "zun" calm, l/p = tilt left or right, then the digits of
  the reached levels 1 to 8 ("l123"). One animation per level adds a quarter of the motion of the
  web (scena.js): card up to 3 % bigger, fields up to 21 px up, 18 % bigger and 3 degrees tilted,
  the second field 66 ms and the third 132 ms later (as in video.py); the levels fall one by one, so the motion pumps.
  The flash of the card on every 8th beat is Visualisation.Locked.
-->
<window>
    <defaultcontrol always="true">900</defaultcontrol>
    <animation effect="fade" time="400">WindowOpen</animation>
    <animation effect="fade" time="300">WindowClose</animation>
    <controls>
        <!-- black background (pure black, logos of record labels are white on black) -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">zun-bila.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>scena-pozadi.jpg</texture>
            <visible>!String.IsEqual(Window.Property(vis),zun)</visible>
