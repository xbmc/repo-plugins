msgctxt "#30000"
msgid "Search all countries"
msgstr "ค้นหาในทุกประเทศ"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "ชื่อสถานี เมือง หรือแนวรายการ"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "ไม่พบสถานีที่ตรงกับ “{q}”"

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "สตรีมนี้ยังเล่นไม่ได้ในขณะนี้"

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "ไม่สามารถเชื่อมต่อ radioko ได้ในขณะนี้"

msgctxt "#30005"
msgid "Loading all countries…"
msgstr "กำลังโหลดทุกประเทศ…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "เลือกประเทศ"

msgctxt "#30007"
msgid "This station's stream can only be heard in its own country: {country}."
msgstr "สตรีมของสถานีนี้ฟังได้เฉพาะในประเทศของสถานีเองเท่านั้น: {country}"

msgctxt "#30008"
msgid "Search"
msgstr "ค้นหา"
