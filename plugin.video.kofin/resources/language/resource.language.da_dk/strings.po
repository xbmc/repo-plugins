msgstr "%s nye film blev ikke hentet automatisk"

msgctxt "#30752"
msgid "Export NFO files and artwork"
msgstr "Eksportér NFO-filer og billedmateriale"

msgctxt "#30753"
msgid "Write NFO metadata and artwork beside downloaded files, so other Kodi profiles and apps can scan the download folder as a library."
msgstr "Skriv NFO-metadata og billedmateriale ved siden af hentede filer, så andre Kodi-profiler og apps kan skanne downloadmappen som et bibliotek."

msgctxt "#30754"
msgid "Download all new episodes"
msgstr "Hent alle nye episoder"

msgctxt "#30755"
msgid "Every episode newly added to a synced library is downloaded automatically."
msgstr "Hver episode, der netop føjes til et synkroniseret bibliotek, hentes automatisk."

msgctxt "#30756"
