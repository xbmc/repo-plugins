msgstr "Αποχώρηση από την ομάδα"

msgctxt "#30563"
msgid "Joined group: %s"
msgstr "Μπήκατε στην ομάδα: %s"

msgctxt "#30564"
msgid "Left the group"
msgstr "Αποχωρήσατε από την ομάδα"

