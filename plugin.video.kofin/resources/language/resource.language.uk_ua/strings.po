msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "На сервері ще немає активного сеансу"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Хто дивиться? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Хто дивиться разом із %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Кого можна додати до сеансу"

msgctxt "#30250"
msgid "Library"
msgstr "Медіатека"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Виберіть медіатеки Jellyfin, які дзеркалюються у власну базу даних Kodi, і керуйте ними."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Виберіть медіатеки для синхронізації"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Виберіть, які медіатеки сервера дзеркалюються в медіатеку Kodi. Зміни застосовуються після підтвердження вибору."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Оновити медіатеки"

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Відновити медіатеки"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Вилучити та наново синхронізувати вибрані медіатеки з нуля, відновивши стан перегляду із сервера. Виконується після підтвердження вибору."

msgctxt "#30262"
msgid "Sync status"
msgstr "Стан синхронізації"

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Вилучити синхронізовану медіатеку?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Вилучити %s з медіатеки Kodi? Об'єкти буде видалено лише з цього пристрою."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Які медіатеки відновити?"

msgctxt "#30267"
msgid "All"
msgstr "Усі"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Виберіть медіатеки"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Немає доступних медіатек"

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Приховувати стан оновлення нижче (об'єктів)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
