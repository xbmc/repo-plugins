msgid "Updating media"
msgstr "Actualizando los medios"

msgctxt "#30403"
msgid "Sync incomplete; retrying shortly"
msgstr "Sincronización incompleta; reintentando"

msgctxt "#30408"
msgid "Removing library"
msgstr "Eliminando la biblioteca"

msgctxt "#30415"
msgid "Connected to %s"
msgstr "Conectado a %s"

msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Se perdió la conexión con el servidor"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "El servidor se está reiniciando"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "El servidor se está apagando"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Sincronización desactivada: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Saltos y reproducir siguiente"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Omisión de segmentos multimedia y aviso de Reproducir siguiente."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Saltar segmentos multimedia"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Obtiene los segmentos multimedia de Jellyfin (intro, créditos, resumen, avance, publicidad) durante la reproducción y actúa según su tipo."

msgctxt "#30455"
msgid "Intros"
msgstr "Intros"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Desactivado ignora los segmentos de intro, Automático los salta y Preguntar muestra un botón para saltarlos."

msgctxt "#30457"
msgid "Credits"
msgstr "Créditos"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
