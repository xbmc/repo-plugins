msgid ""
msgstr ""
"Project-Id-Version: plugin.video.tvsplayer\n"
"Language: pt_PT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "#30000"
msgid "TV"
msgstr "TV"

msgctxt "#30001"
msgid "Radio"
msgstr "Rádio"

msgctxt "#30002"
msgid "Favourites"
msgstr "Favoritos"

msgctxt "#30003"
msgid "Playlists"
msgstr "Listas"

msgctxt "#30004"
msgid "Search"
msgstr "Pesquisar"

msgctxt "#30005"
msgid "All"
msgstr "Todos"

msgctxt "#30006"
msgid "Add M3U playlist (web address)"
msgstr "Adicionar lista M3U (endereço web)"

msgctxt "#30007"
msgid "Add M3U playlist (file)"
msgstr "Adicionar lista M3U (ficheiro)"

msgctxt "#30008"
msgid "Add free radio stations by country"
msgstr "Adicionar rádios gratuitas por país"

msgctxt "#30009"
msgid "Playlist address (http://… .m3u)"
msgstr "Endereço da lista (http://… .m3u)"

msgctxt "#30010"
msgid "Name of the playlist"
msgstr "Nome da lista"

msgctxt "#30011"
msgid "Content of this playlist"
msgstr "Conteúdo desta lista"

msgctxt "#30012"
msgid "Automatic (TV and radio)"
msgstr "Automático (TV e rádio)"

msgctxt "#30013"
msgid "TV only"
msgstr "Só TV"

msgctxt "#30014"
msgid "Radio only"
msgstr "Só rádio"

msgctxt "#30015"
msgid "Loading…"
msgstr "A carregar…"

msgctxt "#30016"
msgid "{1}: {0} channels"
msgstr "{1}: {0} canais"

msgctxt "#30017"
msgid "Could not load the playlist"
msgstr "Não foi possível carregar a lista"

msgctxt "#30018"
msgid "Refresh"
msgstr "Atualizar"

msgctxt "#30019"
msgid "Delete"
msgstr "Eliminar"

msgctxt "#30020"
msgid "Delete \"{0}\"? Its channels are removed. Favourites stay."
msgstr "Eliminar «{0}»? Os canais são removidos. Os favoritos ficam."

msgctxt "#30021"
msgid "Add to favourites"
msgstr "Adicionar aos favoritos"

msgctxt "#30022"
msgid "Remove from favourites"
msgstr "Remover dos favoritos"

msgctxt "#30023"
msgid "Choose link"
msgstr "Escolher ligação"

msgctxt "#30024"
msgid "Link {0}"
msgstr "Ligação {0}"

msgctxt "#30025"
msgid "Channel not available (no working link)"
msgstr "Canal indisponível (nenhuma ligação funciona)"

msgctxt "#30026"
msgid "No channels yet: add your M3U playlist in Playlists"
msgstr "Ainda não há canais: adicione a sua lista M3U em Listas"

msgctxt "#30027"
msgid "Radio stations of…"
msgstr "Rádios de…"

msgctxt "#30028"
msgid "Load free radio stations now? (Radio Browser, an open directory)"
msgstr "Carregar agora as rádios gratuitas? (Radio Browser, um diretório aberto)"

msgctxt "#30029"
msgid "TVS Player does not provide any TV channels. Add only playlists you have the right to use."
msgstr "O TVS Player não fornece canais de TV. Adicione apenas listas que tem o direito de usar."

msgctxt "#30030"
msgid "{0} channels · updated {1}"
msgstr "{0} canais · atualizada {1}"

msgctxt "#30031"
msgid "Added to favourites"
msgstr "Adicionado aos favoritos"

msgctxt "#30032"
msgid "Move up"
msgstr "Mover para cima"

msgctxt "#30033"
msgid "Move down"
msgstr "Mover para baixo"

msgctxt "#30034"
msgid "Search channels and radio"
msgstr "Pesquisar canais e rádios"

msgctxt "#30035"
msgid "never"
msgstr "nunca"

msgctxt "#30036"
msgid "Which link?"
msgstr "Que ligação?"

msgctxt "#30038"
msgid "{0} links"
msgstr "{0} ligações"

msgctxt "#30039"
msgid "No channels found: is this an M3U playlist?"
msgstr "Nenhum canal encontrado: é uma lista M3U?"

msgctxt "#30040"
msgid "The address must start with http:// or https://"
msgstr "O endereço tem de começar por http:// ou https://"

msgctxt "#30041"
msgid "Radio stations – {0}"
msgstr "Rádios – {0}"

msgctxt "#30042"
msgid "Poor internet connection: the channel may not start"
msgstr "Ligação à internet fraca: o canal pode não arrancar"

msgctxt "#30043"
msgid "TV channels of this playlist"
msgstr "Canais de TV desta lista"

msgctxt "#30044"
msgid "Radio stations of this playlist"
msgstr "Rádios desta lista"

msgctxt "#30045"
msgid "TVS Player in the browser and on Android"
msgstr "TVS Player no navegador e no Android"

msgctxt "#30046"
msgid "Your playlists and radio also in any web browser, nothing to install: https://tvsplayer.app\nOn Android phones and tablets: TVS Player (free) and TVS Player Pro (TV guide, rewind, recordings) on Google Play."
msgstr "As suas listas e a rádio também em qualquer navegador, sem instalar nada: https://tvsplayer.app/pt/\nEm telemóveis e tablets Android: TVS Player (gratuito) e TVS Player Pro (guia de TV, recuar, gravações) no Google Play."

msgctxt "#30100"
msgid "General"
msgstr "Geral"

msgctxt "#30101"
msgid "Check links before playing (skip dead links)"
msgstr "Verificar as ligações antes de reproduzir (saltar as que não funcionam)"

msgctxt "#30102"
msgid "Link check timeout (seconds)"
msgstr "Tempo máximo da verificação (segundos)"

msgctxt "#30103"
msgid "Radio stations to load per country"
msgstr "Rádios a carregar por país"

msgctxt "#30104"
msgid "First start done"
msgstr "Primeiro arranque feito"
