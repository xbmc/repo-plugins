msgctxt "#30041"
msgid "Who's watching?"
msgstr "Кто смотрит?"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "На сервере ещё нет активного сеанса"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Кто смотрит? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Кто смотрит вместе с %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Кого можно добавить к сеансу"

msgctxt "#30250"
msgid "Library"
msgstr "Библиотека"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Выбор библиотек Jellyfin, зеркалируемых в собственную базу данных Kodi, и управление ими."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Выбрать библиотеки для синхронизации"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Выберите, какие библиотеки сервера зеркалируются в библиотеку Kodi. Изменения применяются после подтверждения выбора."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Обновить библиотеки"

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Восстановить библиотеки"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Удалить и заново синхронизировать выбранные библиотеки с нуля, восстановив состояние просмотра с сервера. Выполняется после подтверждения выбора."

msgctxt "#30262"
msgid "Sync status"
msgstr "Состояние синхронизации"

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Убрать синхронизированную библиотеку?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Убрать %s из библиотеки Kodi? Элементы удаляются только с этого устройства."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Какие библиотеки восстановить?"

msgctxt "#30267"
msgid "All"
msgstr "Все"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Выбрать библиотеки"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Нет доступных библиотек"

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Скрывать ход обновления менее (элементов)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Скрывать индикатор обновления библиотеки Kodi для синхронизаций меньше указанного размера. 0 — показывать всегда."

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Сжимать обложки"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Перекодировать ограниченные по размеру обложки в JPEG с качеством 90. Без ограничения разрешения не действует."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Максимальное разрешение обложек"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Ограничить высоту синхронизируемых обложек. «Оригинал» сохраняет размер с сервера."

msgctxt "#30322"
msgid "Original"
msgstr "Оригинал"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
