msgctxt "#30000"
msgid "Search all countries"
msgstr "Hľadať vo všetkých krajinách"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "Názov stanice, mesto alebo žáner"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "Hľadaniu „{q}“ nezodpovedá žiadna stanica."

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "Tento stream teraz nehrá."

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "radioko teraz nie je dostupné."

msgctxt "#30005"
msgid "Loading all countries…"
msgstr "Načítavajú sa všetky krajiny…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "Vybrať krajinu"

