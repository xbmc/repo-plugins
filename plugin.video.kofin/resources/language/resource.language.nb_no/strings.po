msgid "Recently added episodes"
msgstr "Nylig lagt til episoder"

msgctxt "#30356"
msgid "In progress episodes"
msgstr "Påbegynte episoder"

msgctxt "#30358"
msgid "Favorite movies"
msgstr "Favorittfilmer"

msgctxt "#30359"
msgid "Favorite shows"
msgstr "Favorittserier"

msgctxt "#30360"
msgid "Favorite episodes"
msgstr "Favorittepisoder"

msgctxt "#30401"
msgid "Updating media"
msgstr "Oppdaterer medier"

msgctxt "#30403"
msgid "Sync incomplete; retrying shortly"
msgstr "Synkronisering ufullstendig, prøver igjen"

msgctxt "#30408"
msgid "Removing library"
msgstr "Fjerner bibliotek"

msgctxt "#30415"
msgid "Connected to %s"
msgstr "Koblet til %s"

msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Mistet forbindelsen til serveren"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "Serveren starter på nytt"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "Serveren slår seg av"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Biblioteksynkronisering er av: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Hopping og spill neste"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Hopping over mediesegmenter og Spill neste-spørsmålet."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Hopp over mediesegmenter"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Hent Jellyfins mediesegmenter (intro, rulletekst, oppsummering, forhåndsvisning, reklame) under avspilling og reager på dem per type."

msgctxt "#30455"
msgid "Intros"
msgstr "Introer"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Av ignorerer introsegmenter, Auto hopper over dem, Spør viser en hopp over-knapp."

msgctxt "#30457"
msgid "Credits"
msgstr "Rulletekst"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Av ignorerer rulletekst, Auto spoler forbi den, Spør tilbyr Hopp over rulletekst — med Spill neste når det finnes en neste episode."

msgctxt "#30459"
msgid "Recaps"
msgstr "Oppsummeringer"

msgctxt "#30460"
msgid "Off ignores recap segments, Auto skips past them, Ask shows a skip button."
msgstr "Av ignorerer oppsummeringssegmenter, Auto hopper over dem, Spør viser en hopp over-knapp."

msgctxt "#30461"
msgid "Previews"
msgstr "Forhåndsvisninger"

msgctxt "#30462"
