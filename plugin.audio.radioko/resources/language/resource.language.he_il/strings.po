msgctxt "#30000"
msgid "Search all countries"
msgstr "חיפוש בכל המדינות"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "שם תחנה, עיר או סגנון"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "לא נמצאה תחנה שמתאימה לחיפוש „{q}”."

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "השידור הזה לא פועל כרגע."

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "אי אפשר להתחבר ל־radioko כרגע."

msgctxt "#30005"
msgid "Loading all countries…"
msgstr "טעינת כל המדינות…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "בחירת מדינה"

msgctxt "#30007"
msgid "This station's stream can only be heard in its own country: {country}."
msgstr "אפשר להאזין לשידור של התחנה הזו רק בארץ שלה: {country}."

msgctxt "#30008"
msgid "Search"
msgstr "חיפוש"
