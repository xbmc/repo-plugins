msgid "Ask"
msgstr "Întreabă"

msgctxt "#30469"
msgid "Offer Play Next"
msgstr "Oferă Redă următorul"

msgctxt "#30470"
msgid "Offer the next episode at the credits, or near the end when no credits segment exists."
msgstr "Oferă episodul următor la generic sau aproape de final când nu există un segment de generic."

msgctxt "#30471"
