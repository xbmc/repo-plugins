msgid "Recently added episodes"
msgstr "Sidst tilføjede episoder"

msgctxt "#30356"
msgid "In progress episodes"
msgstr "Påbegyndte episoder"

msgctxt "#30358"
msgid "Favorite movies"
msgstr "Favoritfilm"

msgctxt "#30359"
msgid "Favorite shows"
msgstr "Favoritserier"

msgctxt "#30360"
msgid "Favorite episodes"
msgstr "Favoritepisoder"

msgctxt "#30401"
msgid "Updating media"
msgstr "Opdaterer medier"

msgctxt "#30403"
msgid "Sync incomplete; retrying shortly"
msgstr "Synk. ufuldstændig, prøver igen"

msgctxt "#30408"
msgid "Removing library"
msgstr "Fjerner bibliotek"

msgctxt "#30415"
msgid "Connected to %s"
msgstr "Forbundet til %s"

msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Mistede forbindelsen til serveren"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "Serveren genstarter"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "Serveren lukker ned"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Synkronisering er slået fra: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Overspring og afspil næste"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Overspringning af mediesegmenter og Afspil næste-prompten."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Spring mediesegmenter over"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Hent Jellyfins mediesegmenter (intro, rulletekster, resumé, forhåndsvisning, reklame) under afspilning, og reagér på dem pr. type."

msgctxt "#30455"
msgid "Intros"
msgstr "Introer"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Fra ignorerer introsegmenter, Auto springer forbi dem, Spørg viser en spring over-knap."

msgctxt "#30457"
msgid "Credits"
msgstr "Rulletekster"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Fra ignorerer rulletekster, Auto spoler forbi dem, Spørg tilbyder Spring outro over — med Afspil næste, når der findes en næste episode."

msgctxt "#30459"
msgid "Recaps"
msgstr "Resuméer"

msgctxt "#30460"
msgid "Off ignores recap segments, Auto skips past them, Ask shows a skip button."
