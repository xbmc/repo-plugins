msgctxt "#30000"
msgid "Search all countries"
msgstr "Αναζήτηση σε όλες τις χώρες"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "Όνομα σταθμού, πόλη ή είδος"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "Κανένας σταθμός δεν ταιριάζει με το «{q}»."

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "Η μετάδοση δεν παίζει αυτή τη στιγμή."

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "Το radioko δεν είναι προσβάσιμο αυτή τη στιγμή."

msgctxt "#30005"
msgid "Loading all countries…"
msgstr "Φόρτωση όλων των χωρών…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "Διάλεξε χώρα"

msgctxt "#30007"
msgid "This station's stream can only be heard in its own country: {country}."
msgstr "Η ροή αυτού του σταθμού ακούγεται μόνο στη δική του χώρα: {country}."

msgctxt "#30008"
msgid "Search"
msgstr "Αναζήτηση"
