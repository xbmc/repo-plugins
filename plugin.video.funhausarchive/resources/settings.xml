<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.funhausarchive">
        <category id="general" label="30000">
            <group id="1" label="30001">
                <setting id="playback_method" type="string" label="30002" help="30003">
                    <level>0</level>
                    <default>YouTube Add-on</default>
                    <constraints>
                        <options>
                            <option>YouTube Add-on</option>
                            <option>Direct Stream (yt-dlp)</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
                <setting id="page_size" type="string" label="30004" help="30005">
                    <level>0</level>
                    <default>100</default>
                    <constraints>
                        <options>
                            <option>50</option>
                            <option>100</option>
                            <option>250</option>
                            <option>All (No Pagination)</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
                <setting id="remember_last_page" type="boolean" label="30006" help="30007">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="video_quality" type="string" label="30008" help="30009">
                    <level>0</level>
                    <default>1080p</default>
                    <constraints>
                        <options>
                            <option>Best Available</option>
                            <option>1080p</option>
                            <option>720p</option>
                            <option>480p</option>
                            <option>360p</option>
                        </options>
                    </constraints>
                    <control type="list" format="string"/>
                </setting>
                <setting id="cache_enabled" type="boolean" label="30010" help="30011">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="cache_ttl_hours" type="integer" label="30012" help="30013">
                    <level>0</level>
                    <default>24</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>168</maximum>
                    </constraints>
                    <control type="slider" format="integer"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
