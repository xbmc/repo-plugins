msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Stratené spojenie so serverom"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "Server sa reštartuje"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "Server sa vypína"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Synchronizácia knižnice vypnutá: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Preskakovanie a prehrať ďalšie"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Preskakovanie segmentov médií a výzva Prehrať ďalšie."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Preskakovať segmenty médií"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Počas prehrávania načíta segmenty médií z Jellyfinu (úvod, záverečné titulky, zhrnutie, ukážka, reklama) a podľa typu na ne zareaguje."

msgctxt "#30455"
msgid "Intros"
msgstr "Úvody"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje segmenty úvodu, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

msgctxt "#30457"
msgid "Credits"
msgstr "Záverečné titulky"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Vypnuté ignoruje záverečné titulky, Automaticky ich preskočí, Opýtať sa ponúkne Preskočiť koniec — a Prehrať ďalšie, keď existuje ďalšia epizóda."

msgctxt "#30459"
msgid "Recaps"
msgstr "Zhrnutia"

msgctxt "#30460"
msgid "Off ignores recap segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje segmenty zhrnutia, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

msgctxt "#30461"
msgid "Previews"
msgstr "Ukážky"

msgctxt "#30462"
msgid "Off ignores preview segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje segmenty ukážok, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

msgctxt "#30463"
msgid "Commercials"
msgstr "Reklamy"

msgctxt "#30464"
msgid "Off ignores commercial segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje reklamné segmenty, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

msgctxt "#30465"
msgid "Off"
msgstr "Vypnuté"

msgctxt "#30466"
msgid "Auto"
msgstr "Automaticky"

msgctxt "#30467"
msgid "Ask"
msgstr "Opýtať sa"

msgctxt "#30469"
msgid "Offer Play Next"
msgstr "Ponúkať Prehrať ďalšie"

msgctxt "#30470"
msgid "Offer the next episode at the credits, or near the end when no credits segment exists."
msgstr "Ponúkne ďalšiu epizódu pri záverečných titulkoch alebo blízko konca, keď segment titulkov neexistuje."

msgctxt "#30471"
msgid "Play Next lead time"
msgstr "Predstih pre Prehrať ďalšie"

msgctxt "#30472"
msgid "Seconds before the end to show the Play Next prompt for content without a credits segment."
msgstr "Koľko sekúnd pred koncom sa zobrazí výzva Prehrať ďalšie pri obsahu bez segmentu záverečných titulkov."

msgctxt "#30473"
msgid "Autoplay next episode"
msgstr "Automaticky prehrať ďalšiu epizódu"

msgctxt "#30474"
msgid "Count down on the Play Next prompt and start the next episode automatically."
msgstr "Na výzve Prehrať ďalšie odpočítava a ďalšiu epizódu spustí automaticky."

msgctxt "#30475"
msgid "Resume offset (seconds)"
msgstr "Posun pokračovania (sekundy)"

msgctxt "#30476"
msgid "Seconds to rewind before the stored resume point."
msgstr "O koľko sekúnd sa pretočí späť pred uložený bod pokračovania."

msgctxt "#30477"
msgid "Hide the skip button after"
msgstr "Skryť tlačidlo preskočenia po"

msgctxt "#30478"
msgid "How far into a segment the skip button disappears. 100% keeps it up for the whole segment."
msgstr "Ako ďaleko v segmente tlačidlo preskočenia zmizne. 100% ho ponechá počas celého segmentu."

msgctxt "#30481"
msgid "Skip Intro"
msgstr "Preskočiť úvod"

msgctxt "#30482"
msgid "Skip Outro"
msgstr "Preskočiť koniec"

msgctxt "#30483"
msgid "Skip Recap"
msgstr "Preskočiť zhrnutie"

msgctxt "#30484"
msgid "Skip Preview"
msgstr "Preskočiť ukážku"

msgctxt "#30485"
msgid "Skip Ad"
msgstr "Preskočiť reklamu"

msgctxt "#30486"
msgid "Play Next"
msgstr "Prehrať ďalšie"

msgctxt "#30487"
msgid "Close"
msgstr "Zavrieť"

msgctxt "#30488"
msgid "Skipped %s"
msgstr "Preskočené: %s"

msgctxt "#30489"
msgid "Up next: %s"
msgstr "Nasleduje: %s"

msgctxt "#30500"
msgid "Extras"
msgstr "Bonusy"

msgctxt "#30501"
msgid "Browse extras"
msgstr "Prehliadať bonusy"

msgctxt "#30502"
msgid "Jellyfin actions"
msgstr "Akcie Jellyfin"

msgctxt "#30504"
msgid "Settings"
msgstr "Nastavenia"

msgctxt "#30505"
msgid "Permanently delete \"%s\" from the server? This cannot be undone."
msgstr "Trvale odstrániť \"%s\" zo servera? Túto akciu nemožno vrátiť späť."

msgctxt "#30506"
msgid "Finished \"%s\". Permanently delete it from the server? This cannot be undone."
msgstr "Dokončené \"%s\". Odstrániť to trvale zo servera? Túto akciu nemožno vrátiť späť."

msgctxt "#30507"
msgid "Server request failed"
msgstr "Požiadavka na server zlyhala"

msgctxt "#30508"
msgid "Mark as watched on Jellyfin"
msgstr "Označiť ako zhliadnuté v Jellyfine"

msgctxt "#30509"
msgid "Mark as unwatched on Jellyfin"
msgstr "Označiť ako nezhliadnuté v Jellyfine"

msgctxt "#30550"
msgid "SyncPlay"
msgstr "SyncPlay"

msgctxt "#30551"
msgid "Enable SyncPlay"
msgstr "Povoliť SyncPlay"

msgctxt "#30552"
msgid "Watch in sync with other Jellyfin clients. Leave Kodi's 'Sync playback to display' off for a reliable experience"
msgstr "Sledujte synchronizovane s ostatnými klientmi Jellyfin. Pre spoľahlivý zážitok nechajte v Kodi vypnutú možnosť Synchronizovať prehrávanie s obrazovkou"

msgctxt "#30557"
msgid "Group notifications"
msgstr "Upozornenia skupiny"

msgctxt "#30558"
msgid "Show member join/leave and group-waiting notifications. Errors are always shown."
msgstr "Zobrazuje upozornenia o pripojení a odchode členov a o čakaní skupiny. Chyby sa zobrazujú vždy."

msgctxt "#30560"
msgid "SyncPlay"
msgstr "SyncPlay"

msgctxt "#30561"
msgid "New group..."
msgstr "Nová skupina..."

msgctxt "#30562"
msgid "Leave group"
msgstr "Opustiť skupinu"

msgctxt "#30563"
msgid "Joined group: %s"
msgstr "Pripojené do skupiny: %s"

msgctxt "#30564"
msgid "Left the group"
msgstr "Skupina opustená"

msgctxt "#30565"
msgid "%s joined the group"
msgstr "%s sa pripojil do skupiny"

msgctxt "#30566"
msgid "%s left the group"
msgstr "%s opustil skupinu"

msgctxt "#30567"
msgid "Group name"
msgstr "Názov skupiny"

msgctxt "#30568"
msgid "Playback stopped — what should the group do?"
msgstr "Prehrávanie sa zastavilo — čo má skupina urobiť?"

msgctxt "#30569"
msgid "Spectator mode: the group will not wait for you"
msgstr "Režim diváka: skupina na vás nebude čakať"

msgctxt "#30570"
msgid "SyncPlay needs a working websocket connection to the server"
msgstr "SyncPlay vyžaduje funkčné websocket spojenie so serverom"

msgctxt "#30571"
msgid "Removed from the group"
msgstr "Odstránené zo skupiny"

msgctxt "#30572"
msgid "Members"
msgstr "Členovia"

msgctxt "#30573"
msgid "Resync with group"
msgstr "Znova synchronizovať so skupinou"

msgctxt "#30574"
msgid "SyncPlay is unavailable (server not reachable?)"
msgstr "SyncPlay je nedostupný (server nie je dostupný?)"

msgctxt "#30575"
msgid "External players cannot be synchronized"
msgstr "Externé prehrávače nemožno synchronizovať"

msgctxt "#30576"
msgid "Playback could not be synchronized"
msgstr "Prehrávanie sa nepodarilo synchronizovať"

msgctxt "#30577"
msgid "buffering"
msgstr "načítava sa"

msgctxt "#30578"
msgid "Could not join the group"
msgstr "Nepodarilo sa pripojiť do skupiny"

msgctxt "#30579"
msgid "You don't have access to some items in the group's queue"
msgstr "K niektorým položkám vo fronte skupiny nemáte prístup"

msgctxt "#30580"
msgid "Become a spectator (group won't wait for me)"
msgstr "Stať sa divákom (skupina na mňa nebude čakať)"

msgctxt "#30581"
msgid "Wait for me again (leave spectator mode)"
msgstr "Znova na mňa čakať (opustiť režim diváka)"

msgctxt "#30582"
msgid "disconnected"
msgstr "odpojené"

msgctxt "#30583"
msgid "The group will wait for you again"
msgstr "Skupina na vás bude znova čakať"

msgctxt "#30584"
msgid "Stop playback for everyone"
msgstr "Zastaviť prehrávanie pre všetkých"

msgctxt "#30585"
msgid "Waiting for the group..."
msgstr "Čaká sa na skupinu..."

msgctxt "#30586"
msgid "Fine sync using tempo"
msgstr "Jemná synchronizácia tempom"

msgctxt "#30587"
msgid "Keeps this device on the group's position by briefly playing faster or slower. A video correction decodes passthrough audio until the next item."
msgstr "Drží toto zariadenie na pozícii skupiny tak, že krátko prehráva rýchlejšie alebo pomalšie. Korekcia videa dekóduje passthrough zvuk až do ďalšej položky."

msgctxt "#30592"
msgid "Fine sync stopped: rate mismatch"
msgstr "Jemná synchronizácia zastavená: tempo nesedí"

msgctxt "#30593"
msgid "Largest video error closed by tempo (ms)"
msgstr "Najväčšia chyba videa vyrovnaná tempom (ms)"

msgctxt "#30594"
msgid "Position errors up to this are closed by playing faster or slower; anything larger is closed with a skip. Higher means fewer skips and longer speed changes."
msgstr "Chyby pozície až do tejto hodnoty sa vyrovnávajú rýchlejším alebo pomalším prehrávaním; väčšie skokom. Vyššia hodnota znamená menej skokov a dlhšie zmeny rýchlosti."

msgctxt "#30595"
msgid "Fastest video correction speed (%)"
msgstr "Najrýchlejšia oprava videa (%)"

msgctxt "#30596"
msgid "The most playback speed may change during a correction. At 25% a 2.5 second error takes 10 seconds to close; lower is less noticeable but slower. Large changes ramp in and out."
msgstr "O koľko sa smie počas opravy najviac zmeniť rýchlosť prehrávania. Pri 25 % sa chyba 2,5 sekundy vyrovná za 10 sekúnd; nižšia je menej nápadná, ale pomalšia. Veľké zmeny sa zavádzajú a ukončujú postupne."

msgctxt "#30604"
msgid "480p"
msgstr "480p"

msgctxt "#30605"
msgid "1440p"
msgstr "1440p"

msgctxt "#30613"
msgid "Audio and subtitle streams"
msgstr "Zvukové stopy a titulky"

msgctxt "#30614"
msgid "Audio stream"
msgstr "Zvuková stopa"

msgctxt "#30615"
msgid "Subtitles"
msgstr "Titulky"

msgctxt "#30616"
msgid "Restarting to change stream..."
msgstr "Reštartuje sa kvôli zmene stopy..."

msgctxt "#30617"
msgid "burned in, restarts playback"
msgstr "vypálené, reštartuje prehrávanie"

msgctxt "#30618"
msgid "Use Jellyfin's default tracks"
msgstr "Používať predvolené stopy Jellyfinu"

msgctxt "#30619"
msgid "Start playback on the audio and subtitle tracks your Jellyfin account asks for, instead of the ones Kodi's own language settings pick. The server resolves both from your Jellyfin profile, so the choice follows you to every client."
msgstr "Prehrávanie sa spustí na zvukových stopách a titulkoch, ktoré žiada váš účet Jellyfin, namiesto tých, ktoré vyberú jazykové nastavenia Kodi. Obe určí server z vášho profilu Jellyfin, takže voľba vás sprevádza na každom klientovi."

msgctxt "#30622"
msgid "Notify about new content"
msgstr "Upozorniť na nový obsah"

msgctxt "#30623"
msgid "Show a notification when new films, shows, episodes, music videos, artists or albums are added to your library."
msgstr "Zobrazí upozornenie, keď do vašej knižnice pribudnú nové filmy, seriály, epizódy, hudobné videá, interpreti alebo albumy."

msgctxt "#30624"
msgid "%s movie added to library"
msgstr "Film %s pridaný do knižnice"

msgctxt "#30625"
msgid "%s movies added to library"
msgstr "Do knižnice pribudlo filmov: %s"

msgctxt "#30626"
msgid "%s show added to library"
msgstr "Seriál %s pridaný do knižnice"

msgctxt "#30627"
msgid "%s new shows added to library"
msgstr "Do knižnice pribudlo seriálov: %s"

msgctxt "#30628"
msgid "%s episode of %s added to library"
msgstr "%s epizóda seriálu %s v knižnici"

msgctxt "#30629"
msgid "%s episodes of %s added to library"
msgstr "%s epizód seriálu %s v knižnici"

msgctxt "#30630"
msgid "%s episodes added to library"
msgstr "Do knižnice pribudlo epizód: %s"

msgctxt "#30631"
msgid "%s music video added to library"
msgstr "Hudobné video %s pridané do knižnice"

msgctxt "#30632"
msgid "%s music videos added to library"
msgstr "Do knižnice pribudlo hudobných videí: %s"

msgctxt "#30633"
msgid "%s added to music library"
msgstr "Interpret %s pridaný do knižnice"

msgctxt "#30634"
msgid "%s artists added to library"
msgstr "Do knižnice pribudlo interpretov: %s"

msgctxt "#30635"
msgid "%s added to music library"
msgstr "Album %s pridaný do knižnice"

msgctxt "#30636"
msgid "%s albums added to library"
msgstr "Do knižnice pribudlo albumov: %s"

msgctxt "#30637"
msgid "Use the server's splashscreen as the backdrop"
msgstr "Použiť úvodný obrázok servera ako pozadie"

msgctxt "#30638"
msgid "Show the Jellyfin server's splashscreen behind the addon instead of the bundled artwork. Refreshed when the service connects, at most once a day."
msgstr "Zobrazí za doplnkom úvodný obrázok servera Jellyfin namiesto priloženej grafiky. Obnoví sa pri pripojení služby, najviac raz za deň."

msgctxt "#30700"
msgid "Downloads"
msgstr "Sťahovanie"

msgctxt "#30701"
msgid "Download items for offline playback"
msgstr "Sťahujte položky na prehrávanie offline"

msgctxt "#30702"
msgid "Enable downloads"
msgstr "Povoliť sťahovanie"

msgctxt "#30703"
msgid "Adds Download to the Jellyfin actions menu and runs the download manager. Only for libraries you sync with Kofin."
msgstr "Pridá Stiahnuť do ponuky Akcie Jellyfin a spustí správcu sťahovania. Len pre knižnice, ktoré synchronizujete s Kofinom."

msgctxt "#30704"
msgid "Download location"
msgstr "Umiestnenie stiahnutých súborov"

msgctxt "#30705"
msgid "Where downloaded files are kept. Leave empty for the addon profile folder"
msgstr "Kde sa uchovávajú stiahnuté súbory. Nechajte prázdne pre priečinok profilu doplnku"

msgctxt "#30706"
msgid "Parallel video downloads"
msgstr "Paralelné sťahovania videa"

msgctxt "#30707"
msgid "How many movies and episodes download at the same time"
msgstr "Koľko filmov a epizód sa sťahuje naraz"

msgctxt "#30708"
msgid "Download"
msgstr "Stiahnuť"

msgctxt "#30709"
msgid "Cancel download"
msgstr "Zrušiť sťahovanie"

msgctxt "#30710"
msgid "Delete download"
msgstr "Odstrániť stiahnutý súbor"

msgctxt "#30712"
msgid "Download complete: %s"
msgstr "Sťahovanie dokončené: %s"

msgctxt "#30713"
msgid "Download failed: %s"
msgstr "Sťahovanie zlyhalo: %s"

msgctxt "#30714"
msgid "Delete the download of %s?"
msgstr "Odstrániť stiahnutý súbor %s?"

msgctxt "#30715"
msgid "Not enough free space for %s"
msgstr "Nedostatok voľného miesta pre %s"

msgctxt "#30717"
msgid "The downloads folder is not writable"
msgstr "Do priečinka sťahovania sa nedá zapisovať"

msgctxt "#30718"
msgid "Downloaded movies"
msgstr "Stiahnuté filmy"

msgctxt "#30719"
msgid "Downloaded shows"
msgstr "Stiahnuté seriály"

msgctxt "#30720"
msgid "Not available offline"
msgstr "Nie je dostupné offline"

msgctxt "#30721"
msgid "Downloaded episodes"
msgstr "Stiahnuté epizódy"

msgctxt "#30722"
msgid "Transcode videos"
msgstr "Prekódovať videá"

msgctxt "#30723"
msgid "Transcode when the original exceeds a limit below or when triggered by settings in the Transcoding tab (HDR, codec, etc)"
msgstr "Prekóduje, keď originál prekročí limit nižšie alebo keď to vyvolajú nastavenia na karte Prekódovanie (HDR, kodek atď.)"

msgctxt "#30724"
msgid "Maximum download bitrate"
msgstr "Maximálny dátový tok sťahovania"

msgctxt "#30725"
msgid "Videos over this total bitrate are transcoded down to it. Unlimited transcodes only for codec, HDR or resolution reasons."
msgstr "Videá nad týmto celkovým dátovým tokom sa naň prekódujú. Neobmedzené prekóduje len z dôvodu kodeku, HDR alebo rozlíšenia."

msgctxt "#30726"
msgid "Maximum download resolution"
msgstr "Maximálne rozlíšenie sťahovania"

msgctxt "#30727"
msgid "Videos wider than this are scaled down. Unlimited never scales."
msgstr "Videá širšie ako toto sa zmenšia. Neobmedzené nezmenšuje nikdy."

msgctxt "#30728"
msgid "Transcode music"
msgstr "Prekódovať hudbu"

msgctxt "#30729"
msgid "Transcode a track only when it is lossless or over the bitrate limit below. Compliant tracks download as the original file."
msgstr "Prekóduje skladbu, len keď je bezstratová alebo prekračuje limit dátového toku nižšie. Vyhovujúce skladby sa stiahnu ako pôvodný súbor."

msgctxt "#30730"
msgid "Transcode music over"
msgstr "Prekódovať hudbu nad"

msgctxt "#30731"
msgid "Tracks over this bitrate, and all lossless tracks, are transcoded. Unlimited transcodes only lossless tracks."
msgstr "Skladby nad týmto dátovým tokom a všetky bezstratové skladby sa prekódujú. Neobmedzené prekóduje len bezstratové skladby."

msgctxt "#30732"
msgid "Transcode music to"
msgstr "Prekódovať hudbu do"

msgctxt "#30733"
msgid "The codec transcoded tracks are encoded with. Opus gives the best quality per megabyte."
msgstr "Kodek, ktorým sa prekódované skladby zakódujú. Opus dáva najlepšiu kvalitu na megabajt."

msgctxt "#30734"
msgid "Transcoded music bitrate"
msgstr "Dátový tok prekódovanej hudby"

msgctxt "#30735"
msgid "The bitrate transcoded tracks are encoded at. 128 kbps Opus is transparent for most listening."
msgstr "Dátový tok, ktorým sa prekódované skladby zakódujú. 128 kbps Opus je pri väčšine počúvania nerozoznateľný."

msgctxt "#30737"
msgid "Kofin downloads"
msgstr "Stiahnuté v Kofine"

msgctxt "#30738"
msgid "Download the next episodes automatically"
msgstr "Automaticky sťahovať ďalšie epizódy"

msgctxt "#30739"
msgid "While watching a downloaded episode, the next unwatched episodes of the show are queued for download at the 50% mark."
msgstr "Počas sledovania stiahnutej epizódy sa na značke 50% zaradia do fronty sťahovania ďalšie nezhliadnuté epizódy seriálu."

msgctxt "#30740"
msgid "Episodes to keep ahead"
msgstr "Koľko epizód držať dopredu"

msgctxt "#30741"
msgid "How many unwatched episodes ahead of the one playing are kept downloaded."
msgstr "Koľko nezhliadnutých epizód pred práve prehrávanou zostáva stiahnutých."

msgctxt "#30742"
msgid "Download newly added movies"
msgstr "Sťahovať novo pridané filmy"

msgctxt "#30743"
msgid "Movies newly added to a synced library are downloaded automatically."
msgstr "Filmy novo pridané do synchronizovanej knižnice sa stiahnu automaticky."

msgctxt "#30746"
msgid "Delete download after watching"
msgstr "Odstrániť stiahnuté po zhliadnutí"

msgctxt "#30747"
msgid "When you finish watching a downloaded item, its local copy is removed. The item stays on the server and in your library."
msgstr "Keď dopozeráte stiahnutú položku, jej miestna kópia sa odstráni. Položka zostáva na serveri a vo vašej knižnici."

msgctxt "#30751"
msgid "%s new movies were not downloaded automatically"
msgstr "Nových filmov nestiahnutých automaticky: %s"

msgctxt "#30752"
msgid "Export NFO files and artwork"
msgstr "Exportovať súbory NFO a grafiku"

msgctxt "#30753"
msgid "Write NFO metadata and artwork beside downloaded files, so other Kodi profiles and apps can scan the download folder as a library."
msgstr "Zapíše metaúdaje NFO a grafiku vedľa stiahnutých súborov, aby iné profily Kodi a aplikácie mohli priečinok sťahovania prehľadať ako knižnicu."

msgctxt "#30754"
msgid "Download all new episodes"
msgstr "Sťahovať všetky nové epizódy"

msgctxt "#30755"
msgid "Every episode newly added to a synced library is downloaded automatically."
msgstr "Každá epizóda novo pridaná do synchronizovanej knižnice sa stiahne automaticky."

msgctxt "#30756"
msgid "Download new albums"
msgstr "Sťahovať nové albumy"

msgctxt "#30757"
msgid "Albums newly added to a synced library are downloaded automatically."
msgstr "Albumy novo pridané do synchronizovanej knižnice sa stiahnu automaticky."

msgctxt "#30758"
msgid "Shows downloading new episodes"
msgstr "Seriály so sťahovaním nových epizód"

msgctxt "#30759"
msgid "Review the shows set to download their new episodes automatically, and untick any to stop."
msgstr "Prezrite si seriály nastavené na automatické sťahovanie nových epizód a odškrtnite tie, ktoré chcete zastaviť."

msgctxt "#30760"
msgid "Download new episodes"
msgstr "Sťahovať nové epizódy"

msgctxt "#30761"
msgid "Stop downloading new episodes"
msgstr "Prestať sťahovať nové epizódy"

msgctxt "#30762"
msgid "New episodes of %s will download automatically"
msgstr "Nové epizódy %s sa budú sťahovať automaticky"

msgctxt "#30763"
msgid "New episodes of %s will no longer download automatically"
msgstr "Nové epizódy %s sa už nebudú sťahovať automaticky"

msgctxt "#30764"
msgid "%s new episodes were not downloaded automatically"
msgstr "Nových epizód nestiahnutých automaticky: %s"

msgctxt "#30765"
msgid "%s new albums were not downloaded automatically"
msgstr "Nových albumov nestiahnutých automaticky: %s"

msgctxt "#30766"
msgid "No shows are set to download new episodes"
msgstr "Žiadny seriál nemá nastavené sťahovanie nových epizód"

msgctxt "#30767"
msgid "Show download notifications"
msgstr "Zobrazovať upozornenia o sťahovaní"

msgctxt "#30768"
msgid "Announce queued and completed downloads. Failures and warnings are always shown."
msgstr "Oznamuje zaradené a dokončené sťahovania. Zlyhania a varovania sa zobrazujú vždy."

msgctxt "#30769"
msgid "Delete download automatically"
msgstr "Odstrániť stiahnuté automaticky"

msgctxt "#30770"
msgid "Remove the local copy without asking. With this off, Kofin asks first each time."
msgstr "Odstráni miestnu kópiu bez opýtania. Keď je toto vypnuté, Kofin sa zakaždým najprv spýta."

msgctxt "#30771"
msgid "Download %s item(s), about %s? %s free"
msgstr "Stiahnuť %s položiek, asi %s? Voľných %s"

msgctxt "#30772"
msgid "Parallel music downloads"
msgstr "Paralelné sťahovania hudby"

msgctxt "#30773"
msgid "How many tracks download at the same time. Tracks are small and mostly overhead, so this can sit well above the video figure."
msgstr "Koľko skladieb sa sťahuje naraz. Skladby sú malé a tvorí ich najmä réžia, takže táto hodnota môže byť pokojne vyššia ako pri videu."

msgctxt "#30775"
msgid "downloaded from the server"
msgstr "stiahnuté zo servera"

msgctxt "#30776"
msgid "Downloading subtitle..."
msgstr "Sťahujú sa titulky..."

msgctxt "#30777"
msgid "Jellyfin account settings"
msgstr "Nastavenia účtu Jellyfin"

msgctxt "#30778"
msgid "Audio and subtitle preferences stored on the server against your Jellyfin account. They apply to every client you sign in from, not just this one."
msgstr "Predvoľby zvuku a titulkov uložené na serveri pri vašom účte Jellyfin. Platia pre každého klienta, na ktorom sa prihlásite, nielen pre tento."

msgctxt "#30779"
msgid "Jellyfin settings for %s"
msgstr "Nastavenia Jellyfin pre %s"

msgctxt "#30780"
msgid "Preferred audio language"
msgstr "Preferovaný jazyk zvuku"

msgctxt "#30781"
msgid "Play default audio track"
msgstr "Prehrať predvolenú zvukovú stopu"

msgctxt "#30782"
msgid "Preferred subtitle language"
msgstr "Preferovaný jazyk titulkov"

msgctxt "#30783"
msgid "Subtitle mode"
msgstr "Režim titulkov"

msgctxt "#30784"
msgid "Remember audio selections"
msgstr "Zapamätať výber zvuku"

msgctxt "#30785"
msgid "Remember subtitle selections"
msgstr "Zapamätať výber titulkov"

msgctxt "#30786"
msgid "Enabled"
msgstr "Povolené"

msgctxt "#30787"
msgid "Disabled"
msgstr "Zakázané"

msgctxt "#30788"
msgid "Any"
msgstr "Ľubovoľný"

msgctxt "#30789"
msgid "Default"
msgstr "Predvolené"

msgctxt "#30790"
msgid "Always"
msgstr "Vždy"

msgctxt "#30791"
msgid "Only forced"
msgstr "Len vynútené"

msgctxt "#30792"
msgid "None"
msgstr "Žiadne"

msgctxt "#30793"
msgid "Smart"
msgstr "Inteligentné"

msgctxt "#30794"
msgid "Not applied here: \"Use Jellyfin's default tracks\" is off"
msgstr "Tu sa neuplatní: \"Používať predvolené stopy Jellyfinu\" je vypnuté"

msgctxt "#30795"
msgid "Could not load your Jellyfin settings"
msgstr "Vaše nastavenia Jellyfin sa nepodarilo načítať"

msgctxt "#30796"
msgid "Could not save to the server"
msgstr "Uloženie na server sa nepodarilo"

msgctxt "#30797"
msgid "Your Jellyfin account is not allowed to change these settings"
msgstr "Váš účet Jellyfin nemá povolené meniť tieto nastavenia"

msgctxt "#30798"
msgid "Skip movie imports larger than"
msgstr "Preskočiť import filmov väčší ako"

msgctxt "#30799"
msgid "When a sync adds more new movies than this at once, none of them are downloaded — a bulk import is rarely a request to fill the disk. Raise it if you want big additions pulled automatically."
msgstr "Keď synchronizácia pridá naraz viac nových filmov, než je toto číslo, nestiahne sa žiadny z nich — hromadný import je zriedka žiadosťou o zaplnenie disku. Zvýšte ho, ak chcete veľké prírastky sťahovať automaticky."

msgctxt "#30800"
msgid "Skip episode imports larger than"
msgstr "Preskočiť import epizód väčší ako"

msgctxt "#30801"
msgid "When a sync adds more new episodes than this at once, none of them are downloaded. Shows you have subscribed to are exempt — a subscription is a standing order."
msgstr "Keď synchronizácia pridá naraz viac nových epizód, než je toto číslo, nestiahne sa žiadna z nich. Seriály, ktoré ste si predplatili, sú výnimkou — predplatné je trvalá objednávka."

msgctxt "#30802"
msgid "Skip album imports larger than"
msgstr "Preskočiť import albumov väčší ako"

msgctxt "#30803"
msgid "When a sync adds more new albums than this at once, none of them are downloaded. Counted in albums, not tracks."
msgstr "Keď synchronizácia pridá naraz viac nových albumov, než je toto číslo, nestiahne sa žiadny z nich. Počíta sa v albumoch, nie v skladbách."

msgctxt "#30810"
msgid "Needs %s, only %s free"
msgstr "Vyžaduje %s, voľných len %s"

msgctxt "#30804"
msgid "Delete all downloads"
msgstr "Odstrániť všetky stiahnuté súbory"

msgctxt "#30805"
msgid "Delete every downloaded file from this device and stop keeping playlists and music libraries in sync. The items stay in your library and play from the server again."
msgstr "Odstráni z tohto zariadenia každý stiahnutý súbor a prestane udržiavať playlisty a hudobné knižnice synchronizované. Položky zostanú vo vašej knižnici a budú sa opäť prehrávať zo servera."

msgctxt "#30806"
msgid "Delete all %s download(s), freeing about %s?"
msgstr "Odstrániť všetkých %s stiahnutých súborov a uvoľniť asi %s?"

msgctxt "#30807"
msgid "There are no downloads to delete"
msgstr "Nie sú žiadne stiahnuté súbory na odstránenie"

msgctxt "#30808"
msgid "Pause downloads during playback"
msgstr "Pozastaviť sťahovanie počas prehrávania"

msgctxt "#30809"
msgid "Do not start new downloads while something is playing, video or music. A file already downloading finishes; the rest wait until playback stops."
msgstr "Nezačne nové sťahovania, kým sa niečo prehráva, video ani hudba. Už prebiehajúce sťahovanie sa dokončí; ostatné počkajú, kým prehrávanie skončí."

msgctxt "#30811"
msgid "Delete stale downloads"
msgstr "Odstrániť staré stiahnuté súbory"

msgctxt "#30812"
msgid "Remove downloaded files nobody has played for a while. Anything you are part-way through is kept, however long it sits. The items stay in your library and play from the server again."
msgstr "Odstráni stiahnuté súbory, ktoré nikto dlhšie neprehral. Čokoľvek, čo máte rozpozerané, zostane, nech tam leží akokoľvek dlho. Položky zostanú vo vašej knižnici a budú sa opäť prehrávať zo servera."

msgctxt "#30813"
msgid "Delete after (days)"
msgstr "Odstrániť po (dňoch)"

msgctxt "#30814"
msgid "How long a download may sit unplayed before it is removed. Playing it again starts the count over."
msgstr "Ako dlho môže stiahnutý súbor ležať neprehraný, kým sa odstráni. Ďalším prehratím sa počítanie začne odznova."

msgctxt "#30817"
msgid "All"
msgstr "Všetci"

msgctxt "#30818"
msgid "A-Z"
msgstr "A-Z"

msgctxt "#30819"
msgid "Show cast in add-on listings"
msgstr "Zobraziť obsadenie v zoznamoch doplnku"

msgctxt "#30820"
msgid "Fetch cast and crew for the shorter add-on listings — Recently added, In progress, Next up, Continue watching, search results and a show's episodes — so the information dialog can show them. Whole-library listings never fetch it, because the server needs about a second for every 40 items. The Kodi library always has cast."
msgstr "Načíta obsadenie a štáb pre kratšie zoznamy doplnku — Nedávno pridané, Rozpozerané, Nasleduje, Pokračovať v sledovaní, výsledky hľadania a epizódy seriálu —, aby ich mohol zobraziť informačný dialóg. Zoznamy zahŕňajúce celú knižnicu ich nenačítajú nikdy, pretože server potrebuje približne sekundu na každých 40 položiek. Knižnica Kodi má obsadenie vždy."

msgctxt "#30821"
msgid "Server error — %s"
msgstr "Chyba servera — %s"

msgctxt "#30823"
msgid "Download deleted: %s"
msgstr "Sťahovanie odstránené: %s"

msgctxt "#30824"
msgid "%s download(s) deleted"
msgstr "Odstránené sťahovania: %s"

msgctxt "#30825"
msgid "Find servers on local network"
msgstr "Nájsť servery v miestnej sieti"

msgctxt "#30826"
msgid "Looks for Jellyfin servers on this network and lists the ones that answer. The one you choose is filled into \"Server address\"."
msgstr "Vyhľadá servery Jellyfin v tejto sieti a zobrazí tie, ktoré odpovedia. Vybraný sa doplní do poľa \"Adresa servera\"."

msgctxt "#30827"
msgid "Searching for Jellyfin servers…"
msgstr "Vyhľadávanie serverov Jellyfin…"

msgctxt "#30828"
msgid "Select a server"
msgstr "Vyberte server"

msgctxt "#30829"
msgid "No Jellyfin servers answered — enter the address manually"
msgstr "Žiadny server Jellyfin neodpovedal — zadajte adresu ručne"

msgctxt "#30830"
msgid "did not answer"
msgstr "neodpovedal"

msgctxt "#30831"
msgid "%s did not answer — the address it gave may not work here"
msgstr "%s neodpovedal — zadaná adresa tu nemusí fungovať"

msgctxt "#30832"
msgid "Storage used"
msgstr "Využité miesto"

msgctxt "#30833"
msgid "Show where the downloads are kept and how much space each kind is using."
msgstr "Zobrazí, kde sú stiahnuté súbory uložené a koľko miesta zaberá každý druh."

msgctxt "#30834"
msgid "Other files in this folder"
msgstr "Ostatné súbory v tomto priečinku"

msgctxt "#30835"
msgid "Nothing has been downloaded yet"
msgstr "Zatiaľ nebolo nič stiahnuté"

msgctxt "#30836"
msgid "Folder too large to measure fully — the totals above are partial"
msgstr "Priečinok je príliš veľký na úplné zmeranie — súčty vyššie sú neúplné"

msgctxt "#30837"
msgid "Watch in sync with other Jellyfin clients."
msgstr "Sledujte synchronizovane s ostatnými klientmi Jellyfin."

msgctxt "#30841"
msgid "Save to Jellyfin"
msgstr "Uložiť do Jellyfin"

msgctxt "#30842"
msgid "This playlist mixes audio and video, which cannot be saved as one Jellyfin playlist"
msgstr "Tento zoznam mieša zvuk a video a nemožno ho uložiť ako jeden zoznam Jellyfin"

msgctxt "#30843"
msgid "Playlist saved to Jellyfin"
msgstr "Zoznam uložený do Jellyfin"

msgctxt "#30844"
msgid "No library items in this playlist to save"
msgstr "V tomto zozname nie sú položky knižnice na uloženie"

msgctxt "#30845"
msgid "Show library update progress"
msgstr "Zobraziť priebeh aktualizácie knižnice"

msgctxt "#30846"
msgid "Show Kodi's library-update progress while the library syncs."
msgstr "Zobrazí priebeh aktualizácie knižnice v Kodi počas synchronizácie."

msgctxt "#30849"
msgid "Download & keep in sync"
msgstr "Stiahnuť a udržiavať synchronizované"

msgctxt "#30850"
msgid "Stop keeping downloads in sync"
msgstr "Prestať synchronizovať sťahovania"

msgctxt "#30851"
msgid "Manage playlist downloads"
msgstr "Spravovať sťahovanie playlistov"

msgctxt "#30852"
msgid "Manage music library downloads"
msgstr "Spravovať sťahovanie hudobných knižníc"

msgctxt "#30853"
msgid "Content not downloaded"
msgstr "Obsah nie je stiahnutý"

msgctxt "#30854"
msgid "Review subscribed playlists; untick to stop syncing downloads."
msgstr "Skontrolujte odoberané playlisty; zrušením výberu zastavíte synchronizáciu stiahnutých súborov."

msgctxt "#30855"
msgid "Review subscribed music libraries; untick to stop syncing downloads."
msgstr "Skontrolujte odoberané hudobné knižnice; zrušením výberu zastavíte synchronizáciu stiahnutých súborov."

msgctxt "#30856"
msgid "Library nodes and playlists"
msgstr "Uzly knižnice a zoznamy skladieb"

msgctxt "#30857"
msgid "Create Kodi library nodes and smart playlists for the synced video libraries, and copy Jellyfin playlists into Kodi under Videos → Playlists → Kofin and Music → Playlists → Kofin. Turning this off removes every node and playlist Kofin created."
msgstr "Vytvárať uzly knižnice Kodi a inteligentné zoznamy pre synchronizované video knižnice a kopírovať zoznamy Jellyfin do Kodi do Video → Zoznamy skladieb → Kofin a Hudba → Zoznamy skladieb → Kofin. Vypnutie odstráni všetky uzly a zoznamy, ktoré Kofin vytvoril."

msgctxt "#30859"
msgid "Library status"
msgstr "Stav knižnice"

msgctxt "#30860"
msgid "What is synced, what is still pending and what the sync is doing now."
msgstr "Čo je synchronizované, čo ešte čaká a čo synchronizácia práve robí."

msgctxt "#30861"
msgid "Transcode music whose bitrate is above the maximum set below. Off, songs play from the server untouched."
msgstr "Prekódovať hudbu, ktorej dátový tok je vyšší než maximum nastavené nižšie. Vypnuté: skladby sa prehrávajú zo servera bez zmeny."

msgctxt "#30862"
msgid "in Kodi / on the server"
msgstr "v Kodi / na serveri"

msgctxt "#30863"
msgid "Pending"
msgstr "Čaká"

msgctxt "#30864"
msgid "Failed"
msgstr "Zlyhalo"

msgctxt "#30865"
msgid "Last full update"
msgstr "Posledná úplná aktualizácia"

msgctxt "#30867"
msgid "Repair to add codec details"
msgstr "Opraviť na doplnenie údajov o kodekoch"

msgctxt "#30868"
msgid "Kodi cannot import"
msgstr "Kodi nedokáže importovať"

msgctxt "#30869"
msgid "Scheduled full update"
msgstr "Plánovaná úplná aktualizácia"

msgctxt "#30870"
msgid "How often to re-read every library from the server. Turn this on if the server lacks the KofinSyncQueue plugin, or deletions there won't reach Kodi."
msgstr "Ako často znova načítať všetky knižnice zo servera. Zapnite, ak server nemá plugin KofinSyncQueue, inak sa odstránenia do Kodi nedostanú."

msgctxt "#30871"
msgid "Daily"
msgstr "Denne"

msgctxt "#30872"
msgid "Weekly"
msgstr "Týždenne"

msgctxt "#30873"
msgid "Update all libraries now?"
msgstr "Aktualizovať teraz všetky knižnice?"

msgctxt "#30874"
msgid "Re-read every library from the server now."
msgstr "Teraz znova načíta všetky knižnice zo servera."

msgctxt "#30876"
msgid "Not on this Kodi"
msgstr "V tomto Kodi nie je k dispozícii"

msgctxt "#30877"
msgid "Season plots"
msgstr "Popisy sezón"

msgctxt "#30878"
msgid "Favorite episodes"
msgstr "Obľúbené epizódy"

msgctxt "#30879"
msgid "Removing emptied collections"
msgstr "Odstraňovanie vyprázdnených kolekcií"

msgctxt "#30880"
msgid "Movie versions"
msgstr "Verzie filmov"

msgctxt "#30881"
msgid "Stream flags"
msgstr "Príznaky stôp"

msgctxt "#30882"
msgid "Song date added"
msgstr "Dátum pridania skladieb"

msgctxt "#30883"
msgid "Removing dropped versions and extras"
msgstr "Odstraňovanie odobratých verzií a bonusov"

msgctxt "#30884"
msgid "Fine sync"
msgstr "Jemná synchronizácia"

msgctxt "#30885"
msgid "Kodi imports a special only with an episode number. Give these one on the server, or play them from the Kofin add-on."
msgstr "Kodi importuje špeciál, len ak má číslo epizódy. Priraďte im ho na serveri alebo ich prehrajte z doplnku Kofin."

msgctxt "#30886"
msgid "KofinSyncQueue"
msgstr "KofinSyncQueue"

msgctxt "#30887"
msgid "Available"
msgstr "K dispozícii"

msgctxt "#30888"
msgid "this profile holds a library from an older Kofin"
msgstr "tento profil obsahuje knižnicu zo staršej verzie Kofin"

msgctxt "#30889"
msgid "Kofin cannot use it. To clean it, go back to Kofin 0.29:"
msgstr "Kofin ju nemôže použiť. Ak ju chcete vyčistiť, vráťte sa na Kofin 0.29:"

msgctxt "#30890"
msgid "Open Kofin in Kodi's add-on list, select Versions and choose 0.29."
msgstr "Otvorte Kofin v zozname doplnkov Kodi, vyberte Verzie a zvoľte 0.29."

msgctxt "#30891"
msgid "In Kofin's settings, log out on the Account tab and run Clean databases."
msgstr "V nastaveniach Kofin sa na karte Účet odhláste a spustite Vyčistiť databázy."

msgctxt "#30892"
msgid "When Kodi has restarted, open Kofin again, select Versions and choose the newest version. Then log in and choose the libraries to sync."
msgstr "Po reštarte Kodi znova otvorte Kofin, vyberte Verzie a zvoľte najnovšiu verziu. Potom sa prihláste a vyberte knižnice na synchronizáciu."

msgctxt "#30893"
msgid "Alternatively, close Kodi and delete its video and music databases by hand, as the Kofin wiki describes:"
msgstr "Prípadne zatvorte Kodi a odstráňte jeho databázy videa a hudby ručne, ako popisuje wiki Kofin:"

msgctxt "#30894"
msgid "No longer on the server"
msgstr "Už nie je na serveri"

msgctxt "#30895"
msgid "%s is no longer on the server and was removed from the library"
msgstr "Knižnica %s už nie je na serveri a bola odstránená z Kodi"

msgctxt "#30896"
msgid "The synced libraries stay in Kodi until you log in again; a different account removes them."
msgstr "Synchronizované knižnice zostanú v Kodi, kým sa znova neprihlásiš; iný účet ich odstráni."

msgctxt "#30897"
msgid "Queued %s of %s tracks"
msgstr "Zaradených %s z %s skladieb"
