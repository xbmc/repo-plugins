msgctxt "#30000"
msgid "Search all countries"
msgstr "Tìm ở tất cả quốc gia"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "Tên đài, thành phố hoặc thể loại"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "Không có đài nào khớp với “{q}”."

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "Hiện không phát được luồng âm thanh này."

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "Hiện không thể kết nối tới radioko."

msgctxt "#30005"
