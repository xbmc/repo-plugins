msgctxt "#30001"
msgid "All movies (A–Z)"
msgstr "Totes les pel·lícules (A–Z)"

msgctxt "#30002"
msgid "Movies by genre"
msgstr "Pel·lícules per gènere"

msgctxt "#30003"
msgid "Lists"
msgstr "Llistes"

msgctxt "#30004"
msgid "Series"
msgstr "Sèries"

msgctxt "#30005"
msgid "Search movies"
msgstr "Cerca pel·lícules"

msgctxt "#30006"
msgid "Browse A–Z"
msgstr "Explora A–Z"

msgctxt "#30007"
msgid "Refresh catalog"
msgstr "Actualitza el catàleg"

msgctxt "#30008"
msgid "Clear catalog cache"
msgstr "Esborra la memòria cau"

msgctxt "#30009"
msgid "Sign in to eFilm"
msgstr "Inicia sessió a eFilm"

msgctxt "#30010"
msgid "Sign out of eFilm"
msgstr "Tanca la sessió a eFilm"

msgctxt "#30014"
msgid "eFilm library username"
msgstr "Usuari de la biblioteca eFilm"

msgctxt "#30015"
msgid "eFilm password"
msgstr "Contrasenya d’eFilm"

msgctxt "#30016"
msgid "Signed in to eFilm."
msgstr "Has iniciat sessió a eFilm."

msgctxt "#30017"
msgid "Signed out of eFilm."
msgstr "Has tancat la sessió a eFilm."

msgctxt "#30018"
msgid "Choose audio and subtitles"
msgstr "Tria l’àudio i els subtítols"

msgctxt "#30019"
msgid "Borrow from eFilm"
msgstr "Demana un préstec a eFilm"

msgctxt "#30020"
msgid "Borrow {title}? This may use one of your available eFilm loans."
msgstr "Vols demanar {title}? Pot consumir un dels teus préstecs d’eFilm."

msgctxt "#30021"
msgid "Resume eFilm loan"
msgstr "Reprèn el préstec d’eFilm"

msgctxt "#30022"
msgid "Resume your existing loan for {title}?"
msgstr "Vols reprendre el préstec de {title}?"

msgctxt "#30023"
msgid "Cancel"
msgstr "Cancel·la"

msgctxt "#30024"
msgid "Borrow"
msgstr "Demana"

msgctxt "#30025"
msgid "Resume"
msgstr "Reprèn"

msgctxt "#30026"
msgid "Next page"
msgstr "Pàgina següent"

msgctxt "#30027"
msgid "Previous page"
msgstr "Pàgina anterior"

msgctxt "#30028"
msgid "Season {number}"
msgstr "Temporada {number}"

msgctxt "#30029"
msgid "Page {current} of {total} · {count} titles"
msgstr "Pàgina {current} de {total} · {count} títols"

msgctxt "#30030"
msgid "Loading catalog…"
msgstr "S’està carregant el catàleg…"

msgctxt "#30031"
msgid "Loading page {current} of {total}"
msgstr "S’està carregant la pàgina {current} de {total}"

msgctxt "#30032"
msgid "eFilm is unavailable. Showing the saved catalog."
msgstr "eFilm no està disponible. Es mostra el catàleg desat."

msgctxt "#30033"
msgid "Catalog cache cleared."
msgstr "S’ha esborrat la memòria cau."

msgctxt "#30034"
msgid "Catalog refreshed."
msgstr "Catàleg actualitzat."

msgctxt "#30035"
msgid "No matching titles."
msgstr "No hi ha títols coincidents."

msgctxt "#30036"
msgid "Popular movies"
msgstr "Pel·lícules populars"

msgctxt "#30037"
msgid "Don’t miss"
msgstr "No t’ho perdis"

msgctxt "#30038"
msgid "Numbers and symbols"
msgstr "Números i símbols"

msgctxt "#30039"
msgid "This link is no longer supported. Open the add-on home menu."
msgstr "Aquest enllaç ja no és compatible. Obre el menú principal."

msgctxt "#30040"
msgid "Sign in to eFilm again."
msgstr "Torna a iniciar sessió a eFilm."

msgctxt "#30041"
msgid "Sign-in failed. Check your library username and password."
msgstr "No s’ha pogut iniciar sessió. Comprova l’usuari i la contrasenya."

msgctxt "#30042"
msgid "Could not connect to eFilm. Try again later."
msgstr "No s’ha pogut connectar amb eFilm. Torna-ho a provar més tard."

msgctxt "#30043"
msgid "eFilm could not complete the request. Try again later."
msgstr "eFilm no ha pogut completar la petició. Torna-ho a provar més tard."

msgctxt "#30044"
msgid "eFilm denied access. Check your account, region, and loan limits."
msgstr "eFilm ha denegat l’accés. Comprova el compte, la regió i els límits de préstec."

msgctxt "#30045"
msgid "This title or loan is no longer available."
msgstr "Aquest títol o préstec ja no està disponible."

msgctxt "#30046"
msgid "Check your existing loans before borrowing again."
msgstr "Comprova els préstecs existents abans de tornar a demanar."

msgctxt "#30047"
msgid "eFilm is receiving too many requests. Try again later."
msgstr "eFilm rep massa peticions. Torna-ho a provar més tard."

msgctxt "#30048"
msgid "eFilm returned an unexpected response. Please report the add-on version."
msgstr "eFilm ha retornat una resposta inesperada. Informa de la versió del complement."

msgctxt "#30049"
msgid "Could not save or remove local data. Check storage space and permissions."
msgstr "No s’han pogut desar o eliminar dades locals. Comprova l’espai i els permisos."

msgctxt "#30050"
msgid "Another add-on operation is still running. Try again shortly."
msgstr "Encara hi ha una altra operació en curs. Torna-ho a provar aviat."

msgctxt "#30051"
msgid "Cancelled."
msgstr "Cancel·lat."

msgctxt "#30052"
msgid "The loan request could not be confirmed. Check your loans on eFilm before trying again."
msgstr "No s’ha pogut confirmar el préstec. Comprova els préstecs a eFilm abans de tornar-ho a provar."

msgctxt "#30053"
msgid "eFilm rejected the loan. Check your remaining credits, account eligibility, and content availability."
msgstr "eFilm ha rebutjat el préstec. Comprova els crèdits, el compte i la disponibilitat."

msgctxt "#30054"
msgid "No compatible audio/subtitle tracks are available for this title."
msgstr "No hi ha pistes d’àudio o subtítols compatibles."

msgctxt "#30055"
msgid "This provider did not supply a supported stream. The loan may already have started."
msgstr "El proveïdor no ha facilitat un flux compatible. El préstec pot haver començat."

msgctxt "#30056"
msgid "This DRM format is not supported on this device."
msgstr "Aquest format DRM no és compatible amb aquest dispositiu."

msgctxt "#30057"
msgid "Enable InputStream Adaptive under My add-ons → VideoPlayer InputStream, then try again."
msgstr "Activa InputStream Adaptive a Els meus complements → VideoPlayer InputStream."

msgctxt "#30058"
msgid "Install InputStream Helper from the Kodi repository, then try again."
msgstr "Instal·la InputStream Helper des del repositori de Kodi."

msgctxt "#30059"
msgid "DRM playback prerequisites are unavailable or setup was cancelled."
msgstr "Els requisits DRM no estan disponibles o s’ha cancel·lat la configuració."

msgctxt "#30060"
msgid "The old loan is no longer active. Confirm a new loan to continue."
msgstr "El préstec antic ja no és actiu. Confirma un préstec nou per continuar."

msgctxt "#30061"
msgid "No eFilm loans remaining. Check your eFilm account for the renewal date."
msgstr "No et queden préstecs d’eFilm. Consulta el teu compte d’eFilm per saber quan es renoven."
