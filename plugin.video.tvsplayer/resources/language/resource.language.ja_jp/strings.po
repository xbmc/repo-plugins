# Kodi Media Center language file
# Addon Name: TVS Player
# Addon id: plugin.video.tvsplayer
msgid ""
msgstr ""
"Project-Id-Version: plugin.video.tvsplayer\n"
"Language: ja_JP\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "#30000"
msgid "TV"
msgstr "テレビ"

msgctxt "#30001"
msgid "Radio"
msgstr "ラジオ"

msgctxt "#30002"
msgid "Favourites"
msgstr "お気に入り"

msgctxt "#30003"
msgid "Playlists"
msgstr "プレイリスト"

msgctxt "#30004"
msgid "Search"
msgstr "検索"

msgctxt "#30005"
msgid "All"
msgstr "すべて"

msgctxt "#30006"
msgid "Add M3U playlist (web address)"
msgstr "M3U プレイリストを追加（Web アドレス）"

msgctxt "#30007"
msgid "Add M3U playlist (file)"
msgstr "M3U プレイリストを追加（ファイル）"

msgctxt "#30008"
msgid "Add free radio stations by country"
msgstr "国別に無料ラジオ局を追加"

msgctxt "#30009"
msgid "Playlist address (http://… .m3u)"
msgstr "プレイリストのアドレス（http://… .m3u）"

msgctxt "#30010"
msgid "Name of the playlist"
msgstr "プレイリストの名前"

msgctxt "#30011"
msgid "Content of this playlist"
msgstr "このプレイリストの内容"

msgctxt "#30012"
msgid "Automatic (TV and radio)"
msgstr "自動（テレビとラジオ）"

msgctxt "#30013"
msgid "TV only"
msgstr "テレビのみ"

msgctxt "#30014"
msgid "Radio only"
msgstr "ラジオのみ"

msgctxt "#30015"
msgid "Loading…"
msgstr "読み込み中…"

msgctxt "#30016"
msgid "{1}: {0} channels"
msgstr "{1}：{0} チャンネル"

msgctxt "#30017"
msgid "Could not load the playlist"
msgstr "プレイリストを読み込めませんでした"

msgctxt "#30018"
msgid "Refresh"
msgstr "更新"

msgctxt "#30019"
msgid "Delete"
msgstr "削除"

msgctxt "#30020"
msgid "Delete \"{0}\"? Its channels are removed. Favourites stay."
msgstr "「{0}」を削除しますか？チャンネルは削除されます。お気に入りは残ります。"

msgctxt "#30021"
msgid "Add to favourites"
msgstr "お気に入りに追加"

msgctxt "#30022"
msgid "Remove from favourites"
msgstr "お気に入りから削除"

msgctxt "#30023"
msgid "Choose link"
msgstr "リンクを選択"

msgctxt "#30024"
msgid "Link {0}"
msgstr "リンク {0}"

msgctxt "#30025"
msgid "Channel not available (no working link)"
msgstr "チャンネルを利用できません（動作するリンクがありません）"

msgctxt "#30026"
msgid "No channels yet: add your M3U playlist in Playlists"
msgstr "チャンネルがありません：「プレイリスト」で M3U プレイリストを追加してください"

msgctxt "#30027"
msgid "Radio stations of…"
msgstr "ラジオ局の国…"

msgctxt "#30028"
msgid "Load free radio stations now? (Radio Browser, an open directory)"
msgstr "今すぐ無料ラジオ局を読み込みますか？（オープンなディレクトリ Radio Browser）"

msgctxt "#30029"
msgid "TVS Player does not provide any TV channels. Add only playlists you have the right to use."
msgstr "TVS Player はテレビチャンネルを提供しません。利用する権利のあるプレイリストだけを追加してください。"

msgctxt "#30030"
msgid "{0} channels · updated {1}"
msgstr "{0} チャンネル · 更新 {1}"

msgctxt "#30031"
msgid "Added to favourites"
msgstr "お気に入りに追加しました"

msgctxt "#30032"
msgid "Move up"
msgstr "上へ移動"

msgctxt "#30033"
msgid "Move down"
msgstr "下へ移動"

msgctxt "#30034"
msgid "Search channels and radio"
msgstr "チャンネルとラジオを検索"

msgctxt "#30035"
msgid "never"
msgstr "なし"

msgctxt "#30036"
msgid "Which link?"
msgstr "どのリンク？"

msgctxt "#30038"
msgid "{0} links"
msgstr "{0} 件のリンク"

msgctxt "#30039"
msgid "No channels found: is this an M3U playlist?"
msgstr "チャンネルが見つかりません：M3U プレイリストですか？"

msgctxt "#30040"
msgid "The address must start with http:// or https://"
msgstr "アドレスは http:// または https:// で始まる必要があります"

msgctxt "#30041"
msgid "Radio stations – {0}"
msgstr "ラジオ局 – {0}"

msgctxt "#30042"
msgid "Poor internet connection: the channel may not start"
msgstr "インターネット接続が不安定です：チャンネルが開始できない可能性があります"

msgctxt "#30043"
msgid "TV channels of this playlist"
msgstr "このプレイリストのテレビチャンネル"

msgctxt "#30044"
msgid "Radio stations of this playlist"
msgstr "このプレイリストのラジオ局"

msgctxt "#30045"
msgid "TVS Player in the browser and on Android"
msgstr "ブラウザと Android の TVS Player"

msgctxt "#30046"
msgid "Your playlists and radio also in any web browser, nothing to install: https://tvsplayer.app\nOn Android phones and tablets: TVS Player (free) and TVS Player Pro (TV guide, rewind, recordings) on Google Play."
msgstr "インストール不要で、どのブラウザでもプレイリストとラジオを使えます：https://tvsplayer.app/ja/\nAndroid スマホとタブレット：Google Play の TVS Player（無料）と TVS Player Pro（番組表、巻き戻し、録画）。"

msgctxt "#30100"
msgid "General"
msgstr "一般"

msgctxt "#30101"
msgid "Check links before playing (skip dead links)"
msgstr "再生前にリンクを確認（動作しないリンクをスキップ）"

msgctxt "#30102"
msgid "Link check timeout (seconds)"
msgstr "リンク確認のタイムアウト（秒）"

msgctxt "#30103"
msgid "Radio stations to load per country"
msgstr "国ごとに読み込むラジオ局の数"

msgctxt "#30104"
msgid "First start done"
msgstr "初回起動済み"
