msgctxt "#30250"
msgid "Library"
msgstr "Βιβλιοθήκη"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Επιλέξτε και διαχειριστείτε τις βιβλιοθήκες Jellyfin που αντικατοπτρίζονται στη βάση δεδομένων του Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Επιλογή βιβλιοθηκών για συγχρονισμό"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Επιλέξτε ποιες βιβλιοθήκες του διακομιστή αντικατοπτρίζονται στη βιβλιοθήκη του Kodi. Οι αλλαγές εφαρμόζονται όταν επιβεβαιώσετε την επιλογή."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Ενημέρωση βιβλιοθηκών"

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Επιδιόρθωση βιβλιοθηκών"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Αφαιρεί και συγχρονίζει ξανά από την αρχή τις βιβλιοθήκες που επιλέγετε, επαναφέροντας την κατάσταση προβολής από τον διακομιστή. Εκτελείται όταν επιβεβαιώσετε την επιλογή."

msgctxt "#30262"
msgid "Sync status"
msgstr "Κατάσταση συγχρονισμού"

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Αφαίρεση συγχρονισμένης βιβλιοθήκης;"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Αφαίρεση της «%s» από τη βιβλιοθήκη του Kodi; Τα στοιχεία διαγράφονται μόνο από αυτή τη συσκευή."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Ποιες βιβλιοθήκες να επιδιορθωθούν;"

msgctxt "#30267"
msgid "All"
msgstr "Όλες"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Επιλογή βιβλιοθηκών"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Δεν υπάρχουν διαθέσιμες βιβλιοθήκες"

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Απόκρυψη κατάστασης ενημέρωσης κάτω από (στοιχεία)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Αποκρύπτει την πρόοδο ενημέρωσης βιβλιοθήκης του Kodi για συγχρονισμούς μικρότερους από αυτό. Το 0 την εμφανίζει πάντα."

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Συμπίεση γραφικών"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Επανακωδικοποιεί τα περιορισμένα γραφικά σε JPEG ποιότητας 90. Καμία επίδραση χωρίς όριο ανάλυσης."

msgctxt "#30320"
