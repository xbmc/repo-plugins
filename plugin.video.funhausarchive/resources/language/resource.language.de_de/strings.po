# Settings
msgctxt "#30000"
msgid "General Settings"
msgstr "Allgemeine Einstellungen"

msgctxt "#30001"
msgid "Playback & Navigation"
msgstr "Wiedergabe & Navigation"

msgctxt "#30002"
msgid "Playback Method"
msgstr "Wiedergabemethode"

msgctxt "#30003"
msgid "Recommended: YouTube Add-on handles playback via Kodi's official YouTube plugin."
msgstr "Empfohlen: Das YouTube-Addon übernimmt die Wiedergabe über das offizielle Kodi-YouTube-Plugin."

msgctxt "#30004"
msgid "Videos Per Page"
msgstr "Videos pro Seite"

msgctxt "#30005"
msgid "Number of videos to display per page in large video listings."
msgstr "Anzahl der Videos, die pro Seite in großen Listen angezeigt werden sollen."

msgctxt "#30006"
msgid "Remember Last Visited Page"
msgstr "Zuletzt besuchte Seite merken"

msgctxt "#30007"
msgid "Persist pagination position across Kodi restarts and show Resume shortcuts"
msgstr "Seitenposition über Kodi-Neustarts hinweg speichern und Fortsetzen-Verknüpfungen anzeigen"

msgctxt "#30008"
msgid "Maximum Video Quality"
msgstr "Maximale Videoqualität"

msgctxt "#30009"
msgid "Preferred maximum video resolution when using direct resolver"
msgstr "Bevorzugte maximale Videoauflösung bei direkter Wiedergabe"

msgctxt "#30010"
msgid "Enable Metadata Caching"
msgstr "Metadaten-Caching aktivieren"

msgctxt "#30011"
msgid "Cache website scrape responses locally to speed up navigation"
msgstr "Scrape-Antworten der Website lokal zwischenspeichern, um die Navigation zu beschleunigen"

msgctxt "#30012"
msgid "Cache Expiration (Hours)"
msgstr "Cache-Ablaufzeit (Stunden)"

msgctxt "#30013"
msgid "Number of hours before refreshing cached lists"
msgstr "Anzahl der Stunden vor dem Aktualisieren zwischengespeicherter Listen"

# Navigation Menus
msgctxt "#30100"
msgid "All Videos"
msgstr "Alle Videos"

msgctxt "#30101"
msgid "Browse all 4,899+ videos with chronological and custom sorting filters."
msgstr "Alle 4.899+ Videos mit chronologischen und benutzerdefinierten Sortierfiltern durchsuchen."

msgctxt "#30102"
msgid "Browse by Series"
msgstr "Nach Serien durchsuchen"

msgctxt "#30103"
msgid "Explore 40+ curated series (Demo Disk, Dude Soup, GTA 5, Wheelhaus, etc.)."
msgstr "Über 40 kuratierte Serien erkunden (Demo Disk, Dude Soup, GTA 5, Wheelhaus usw.)."

msgctxt "#30104"
msgid "Browse by Cast"
msgstr "Nach Darstellern durchsuchen"

msgctxt "#30105"
msgid "Browse videos featuring James, Bruce, Elyse, Adam, Lawrence, Jacob, and more."
msgstr "Videos mit James, Bruce, Elyse, Adam, Lawrence, Jacob und mehr anzeigen."

msgctxt "#30106"
msgid "Browse by Year"
msgstr "Nach Jahr durchsuchen"

msgctxt "#30107"
msgid "Browse complete archives year-by-year from 2015 to 2024."
msgstr "Komplette Archive Jahr für Jahr von 2015 bis 2024 durchsuchen."

msgctxt "#30108"
msgid "Browse by Content Type"
msgstr "Nach Inhaltstyp durchsuchen"

msgctxt "#30109"
msgid "Filter by Gameplay, Podcasts, Full Episodes, Clips, Shorts, and Compilations."
msgstr "Nach Gameplay, Podcasts, ganzen Folgen, Clips, Shorts und Zusammenschnitten filtern."

msgctxt "#30110"
msgid "Search Videos"
msgstr "Videos suchen"

msgctxt "#30111"
msgid "Search through thousands of archived Funhaus episodes by title or cast."
msgstr "Tausende archivierte Funhaus-Episoden nach Titel oder Besetzung durchsuchen."

# Resume & Pagination
msgctxt "#30120"
msgid "Resume: {title} (Page {page} of {total})"
msgstr "Fortsetzen: {title} (Seite {page} von {total})"

msgctxt "#30121"
msgid "Resume: {title} (Page {page})"
msgstr "Fortsetzen: {title} (Seite {page})"

msgctxt "#30122"
msgid "Jump directly back to page {page} where you left off across Kodi restarts."
msgstr "Direkt zu Seite {page} zurückkehren, wo Sie vor dem Kodi-Neustart aufgehört haben."

msgctxt "#30123"
msgid "Reset Resume Bookmark to Page 1"
msgstr "Fortsetzen-Lesezeichen auf Seite 1 zurücksetzen"

msgctxt "#30124"
msgid "Resume bookmark reset to Page 1"
msgstr "Fortsetzen-Lesezeichen auf Seite 1 zurückgesetzt"

msgctxt "#30125"
msgid "Previous Page (Page {page} of {total})"
msgstr "Vorherige Seite (Seite {page} von {total})"

msgctxt "#30126"
msgid "Go back to page {page}."
msgstr "Zurück zu Seite {page}."

msgctxt "#30127"
msgid "Jump to Page... (Currently Page {page} of {total})"
msgstr "Zu Seite springen... (Aktuell Seite {page} von {total})"

msgctxt "#30128"
msgid "Jump directly to any page number between 1 and {total}."
msgstr "Direkt zu einer beliebigen Seitenzahl zwischen 1 und {total} springen."

msgctxt "#30129"
msgid "Next Page >> (Page {page} of {total}) [Showing {start}-{end} of {total_videos}]"
msgstr "Nächste Seite >> (Seite {page} von {total}) [{start}-{end} von {total_videos} angezeigt]"

msgctxt "#30130"
msgid "Proceed to page {page} of {total}."
msgstr "Weiter zu Seite {page} von {total}."

msgctxt "#30131"
msgid "Jump to Page (1 - {total}):"
msgstr "Zu Seite springen (1 - {total}):"

# Sort Options
msgctxt "#30140"
msgid "Oldest First (Chronological)"
msgstr "Älteste zuerst (Chronologisch)"

msgctxt "#30141"
msgid "Oldest First (Chronological) [From Page 1]"
msgstr "Älteste zuerst (Chronologisch) [Ab Seite 1]"

msgctxt "#30142"
msgid "Watch the Funhaus archive in chronological order from February 2015 forward."
msgstr "Das Funhaus-Archiv in chronologischer Reihenfolge ab Februar 2015 ansehen."

msgctxt "#30143"
msgid "Newest First"
msgstr "Neueste zuerst"

msgctxt "#30144"
msgid "Most recently uploaded videos first."
msgstr "Zuletzt hochgeladene Videos zuerst."

msgctxt "#30145"
msgid "Most Viewed"
msgstr "Meistgesehen"

msgctxt "#30146"
msgid "Highest all-time view counts."
msgstr "Höchste Aufrufzahlen aller Zeiten."

msgctxt "#30147"
msgid "Most Liked"
msgstr "Beliebteste"

msgctxt "#30148"
msgid "Fan-favorite videos with the most likes."
msgstr "Lieblingsvideos der Fans mit den meisten Likes."

msgctxt "#30149"
msgid "Longest First"
msgstr "Längste zuerst"

msgctxt "#30150"
msgid "Longest podcasts, livestreams, and full gameplay recordings."
msgstr "Längste Podcasts, Livestreams und vollständige Gameplay-Aufzeichnungen."

msgctxt "#30151"
msgid "Shortest First"
msgstr "Kürzeste zuerst"

msgctxt "#30152"
msgid "Quick clips, shorts, and highlights."
msgstr "Kurze Clips, Shorts und Highlights."

msgctxt "#30153"
msgid "Title (A-Z)"
msgstr "Titel (A-Z)"

msgctxt "#30154"
msgid "Alphabetical order by video title."
msgstr "Alphabetische Reihenfolge nach Videotitel."

msgctxt "#30155"
msgid "Title (Z-A)"
msgstr "Titel (Z-A)"

msgctxt "#30156"
msgid "Reverse alphabetical order by video title."
msgstr "Umgekehrte alphabetische Reihenfolge nach Videotitel."

msgctxt "#30157"
msgid "Random / Shuffle"
msgstr "Zufällig / Mischen"

msgctxt "#30158"
msgid "Random shuffle of the entire 4,900 video library."
msgstr "Zufällige Wiedergabe der gesamten Bibliothek mit 4.900 Videos."

# Dialogs & Notifications
msgctxt "#30160"
msgid "Search Funhaus Archive"
msgstr "Funhaus-Archiv durchsuchen"

msgctxt "#30161"
msgid "No videos found for this selection."
msgstr "Keine Videos für diese Auswahl gefunden."

msgctxt "#30162"
msgid "Failed to resolve video stream"
msgstr "Videostream konnte nicht aufgelöst werden"

msgctxt "#30163"
msgid "videos"
msgstr "Videos"
