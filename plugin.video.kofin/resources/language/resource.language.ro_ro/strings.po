msgstr "SyncPlay indisponibil (server inaccesibil?)"

msgctxt "#30575"
msgid "External players cannot be synchronized"
msgstr "Playerele externe nu pot fi sincronizate"

msgctxt "#30576"
msgid "Playback could not be synchronized"
msgstr "Redarea nu a putut fi sincronizată"

msgctxt "#30577"
