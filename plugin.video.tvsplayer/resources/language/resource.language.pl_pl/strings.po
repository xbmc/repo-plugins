# Kodi Media Center language file
# Addon Name: TVS Player
# Addon id: plugin.video.tvsplayer
msgid ""
msgstr ""
"Project-Id-Version: plugin.video.tvsplayer\n"
"Language: pl_PL\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "#30000"
msgid "TV"
msgstr "TV"

msgctxt "#30001"
msgid "Radio"
msgstr "Radio"

msgctxt "#30002"
msgid "Favourites"
msgstr "Ulubione"

msgctxt "#30003"
msgid "Playlists"
msgstr "Playlisty"

msgctxt "#30004"
msgid "Search"
msgstr "Szukaj"

msgctxt "#30005"
msgid "All"
msgstr "Wszystkie"

msgctxt "#30006"
msgid "Add M3U playlist (web address)"
msgstr "Dodaj playlistę M3U (adres internetowy)"

msgctxt "#30007"
msgid "Add M3U playlist (file)"
msgstr "Dodaj playlistę M3U (plik)"

msgctxt "#30008"
msgid "Add free radio stations by country"
msgstr "Dodaj darmowe stacje radiowe według kraju"

msgctxt "#30009"
msgid "Playlist address (http://… .m3u)"
msgstr "Adres playlisty (http://… .m3u)"

msgctxt "#30010"
msgid "Name of the playlist"
msgstr "Nazwa playlisty"

msgctxt "#30011"
msgid "Content of this playlist"
msgstr "Zawartość tej playlisty"

msgctxt "#30012"
msgid "Automatic (TV and radio)"
msgstr "Automatycznie (TV i radio)"

msgctxt "#30013"
msgid "TV only"
msgstr "Tylko TV"

msgctxt "#30014"
msgid "Radio only"
msgstr "Tylko radio"

msgctxt "#30015"
msgid "Loading…"
msgstr "Ładowanie…"

msgctxt "#30016"
msgid "{1}: {0} channels"
msgstr "{1}: {0} kanałów"

msgctxt "#30017"
msgid "Could not load the playlist"
msgstr "Nie udało się wczytać playlisty"

msgctxt "#30018"
msgid "Refresh"
msgstr "Odśwież"

msgctxt "#30019"
msgid "Delete"
msgstr "Usuń"

msgctxt "#30020"
msgid "Delete \"{0}\"? Its channels are removed. Favourites stay."
msgstr "Usunąć „{0}”? Jej kanały zostaną usunięte. Ulubione zostają."

msgctxt "#30021"
msgid "Add to favourites"
msgstr "Dodaj do ulubionych"

msgctxt "#30022"
msgid "Remove from favourites"
msgstr "Usuń z ulubionych"

msgctxt "#30023"
msgid "Choose link"
msgstr "Wybierz link"

msgctxt "#30024"
msgid "Link {0}"
msgstr "Link {0}"

msgctxt "#30025"
msgid "Channel not available (no working link)"
msgstr "Kanał niedostępny (żaden link nie działa)"

msgctxt "#30026"
msgid "No channels yet: add your M3U playlist in Playlists"
msgstr "Brak kanałów: dodaj swoją playlistę M3U w Playlistach"

msgctxt "#30027"
msgid "Radio stations of…"
msgstr "Stacje radiowe z…"

msgctxt "#30028"
msgid "Load free radio stations now? (Radio Browser, an open directory)"
msgstr "Wczytać teraz darmowe stacje radiowe? (Radio Browser, otwarty katalog)"

msgctxt "#30029"
msgid "TVS Player does not provide any TV channels. Add only playlists you have the right to use."
msgstr "TVS Player nie dostarcza kanałów TV. Dodawaj tylko playlisty, z których masz prawo korzystać."

msgctxt "#30030"
msgid "{0} channels · updated {1}"
msgstr "{0} kanałów · aktualizacja {1}"

msgctxt "#30031"
msgid "Added to favourites"
msgstr "Dodano do ulubionych"

msgctxt "#30032"
msgid "Move up"
msgstr "W górę"

msgctxt "#30033"
msgid "Move down"
msgstr "W dół"

msgctxt "#30034"
msgid "Search channels and radio"
msgstr "Szukaj kanałów i radia"

msgctxt "#30035"
msgid "never"
msgstr "nigdy"

msgctxt "#30036"
msgid "Which link?"
msgstr "Który link?"

msgctxt "#30038"
msgid "{0} links"
msgstr "{0} linków"

msgctxt "#30039"
msgid "No channels found: is this an M3U playlist?"
msgstr "Nie znaleziono kanałów: czy to playlista M3U?"

msgctxt "#30040"
msgid "The address must start with http:// or https://"
msgstr "Adres musi zaczynać się od http:// lub https://"

msgctxt "#30041"
msgid "Radio stations – {0}"
msgstr "Stacje radiowe – {0}"

msgctxt "#30042"
msgid "Poor internet connection: the channel may not start"
msgstr "Słabe połączenie z internetem: kanał może się nie uruchomić"

msgctxt "#30043"
msgid "TV channels of this playlist"
msgstr "Kanały TV z tej playlisty"

msgctxt "#30044"
msgid "Radio stations of this playlist"
msgstr "Stacje radiowe z tej playlisty"

msgctxt "#30045"
msgid "TVS Player in the browser and on Android"
msgstr "TVS Player w przeglądarce i na Androidzie"

msgctxt "#30046"
msgid "Your playlists and radio also in any web browser, nothing to install: https://tvsplayer.app\nOn Android phones and tablets: TVS Player (free) and TVS Player Pro (TV guide, rewind, recordings) on Google Play."
msgstr "Twoje playlisty i radio także w każdej przeglądarce, bez instalowania: https://tvsplayer.app/pl/\nNa telefonach i tabletach z Androidem: TVS Player (za darmo) i TVS Player Pro (program TV, cofanie, nagrania) w Google Play."

msgctxt "#30100"
msgid "General"
msgstr "Ogólne"

msgctxt "#30101"
msgid "Check links before playing (skip dead links)"
msgstr "Sprawdzaj linki przed odtworzeniem (pomijaj niedziałające)"

msgctxt "#30102"
msgid "Link check timeout (seconds)"
msgstr "Limit czasu sprawdzania linków (sekundy)"

msgctxt "#30103"
msgid "Radio stations to load per country"
msgstr "Liczba stacji radiowych na kraj"

msgctxt "#30104"
msgid "First start done"
msgstr "Pierwsze uruchomienie wykonane"
