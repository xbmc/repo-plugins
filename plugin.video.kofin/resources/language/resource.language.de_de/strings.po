msgid "Favorite movies"
msgstr "Lieblingsfilme"

msgctxt "#30359"
msgid "Favorite shows"
msgstr "Lieblingsserien"

msgctxt "#30360"
msgid "Favorite episodes"
msgstr "Lieblingsfolgen"

msgctxt "#30401"
msgid "Updating media"
msgstr "Medien werden aktualisiert"

msgctxt "#30403"
msgid "Sync incomplete; retrying shortly"
msgstr "Sync unvollständig, neuer Versuch"

msgctxt "#30408"
msgid "Removing library"
msgstr "Bibliothek wird entfernt"

msgctxt "#30415"
msgid "Connected to %s"
msgstr "Verbunden mit %s"

msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Verbindung zum Server verloren"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "Server startet neu"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "Server fährt herunter"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Bibliotheks-Sync ist aus: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Überspringen & Nächste Folge"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Überspringen von Mediensegmenten und die „Nächste Folge“-Abfrage."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Mediensegmente überspringen"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Jellyfin-Mediensegmente (Intro, Abspann, Rückblick, Vorschau, Werbung) während der Wiedergabe abrufen und je nach Typ darauf reagieren."

msgctxt "#30455"
msgid "Intros"
msgstr "Intro"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Aus ignoriert Intro-Segmente, Automatisch überspringt sie, Nachfragen zeigt eine Schaltfläche zum Überspringen."

msgctxt "#30457"
msgid "Credits"
msgstr "Abspann"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Aus ignoriert den Abspann, Automatisch springt darüber hinweg, Nachfragen bietet „Abspann überspringen“ — mit „Nächste Folge“, wenn es eine nächste Folge gibt."

msgctxt "#30459"
msgid "Recaps"
msgstr "Rückblicke"

msgctxt "#30460"
msgid "Off ignores recap segments, Auto skips past them, Ask shows a skip button."
msgstr "Aus ignoriert Rückblick-Segmente, Automatisch überspringt sie, Nachfragen zeigt eine Schaltfläche zum Überspringen."

msgctxt "#30461"
msgid "Previews"
msgstr "Vorschauen"

msgctxt "#30462"
msgid "Off ignores preview segments, Auto skips past them, Ask shows a skip button."
msgstr "Aus ignoriert Vorschau-Segmente, Automatisch überspringt sie, Nachfragen zeigt eine Schaltfläche zum Überspringen."

msgctxt "#30463"
msgid "Commercials"
msgstr "Werbung"

msgctxt "#30464"
msgid "Off ignores commercial segments, Auto skips past them, Ask shows a skip button."
msgstr "Aus ignoriert Werbesegmente, Automatisch überspringt sie, Nachfragen zeigt eine Schaltfläche zum Überspringen."

msgctxt "#30465"
msgid "Off"
msgstr "Aus"

msgctxt "#30466"
msgid "Auto"
msgstr "Automatisch"

msgctxt "#30467"
msgid "Ask"
msgstr "Nachfragen"

msgctxt "#30469"
msgid "Offer Play Next"
msgstr "„Nächste Folge“ anbieten"

msgctxt "#30470"
msgid "Offer the next episode at the credits, or near the end when no credits segment exists."
msgstr "Die nächste Folge beim Abspann anbieten, oder gegen Ende, wenn es kein Abspann-Segment gibt."

msgctxt "#30471"
msgid "Play Next lead time"
msgstr "Vorlauf für „Nächste Folge“"

msgctxt "#30472"
msgid "Seconds before the end to show the Play Next prompt for content without a credits segment."
msgstr "Sekunden vor dem Ende, ab denen die „Nächste Folge“-Abfrage bei Inhalten ohne Abspann-Segment erscheint."

msgctxt "#30473"
msgid "Autoplay next episode"
msgstr "Nächste Folge automatisch starten"

msgctxt "#30474"
msgid "Count down on the Play Next prompt and start the next episode automatically."
msgstr "In der „Nächste Folge“-Abfrage herunterzählen und die nächste Folge automatisch starten."

msgctxt "#30475"
