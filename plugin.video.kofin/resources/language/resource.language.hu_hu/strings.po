msgctxt "#30041"
msgid "Who's watching?"
msgstr "Ki néz?"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Még nincs aktív munkamenet a kiszolgálón"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Ki néz? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Ki néz %s mellett?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Ki adható hozzá a munkamenethez"

msgctxt "#30250"
msgid "Library"
msgstr "Médiatár"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "A Kodi saját adatbázisába tükrözött Jellyfin-médiatárak kiválasztása és kezelése."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Szinkronizálandó médiatárak kiválasztása"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Válassza ki, mely kiszolgálói médiatárak tükröződjenek a Kodi médiatárába. A módosítások a kiválasztás megerősítésekor lépnek életbe."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Médiatárak frissítése"

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Médiatárak javítása"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "A kiválasztott médiatárak eltávolítása és újraszinkronizálása a nulláról, a megtekintettségi állapot visszaállításával a kiszolgálóról. A kiválasztás megerősítésekor fut le."

msgctxt "#30262"
msgid "Sync status"
msgstr "Szinkronizálás állapota"

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Eltávolítja a szinkronizált médiatárat?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Eltávolítja a Kodi médiatárából: %s? Az elemek csak erről az eszközről törlődnek."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Mely médiatárakat javítsa?"

msgctxt "#30267"
msgid "All"
msgstr "Összes"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Médiatárak kiválasztása"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Nincs elérhető médiatár"

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Frissítési állapot elrejtése ez alatt (elem)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "A Kodi médiatár-frissítési folyamatjelzőjének elrejtése az ennél kisebb szinkronizálásoknál. A 0 mindig megjeleníti."

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Grafikák tömörítése"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "A korlátozott méretű grafikák újrakódolása 90-es JPEG-minőséggel. Felbontáskorlát nélkül nincs hatása."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Grafikák maximális felbontása"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "A szinkronizált grafikák magasságának korlátozása. Az Eredeti megtartja a kiszolgálón lévő méretet."

msgctxt "#30322"
msgid "Original"
msgstr "Eredeti"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

msgctxt "#30325"
msgid "2160p"
msgstr "2160p"

