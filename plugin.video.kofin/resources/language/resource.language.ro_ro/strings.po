msgstr "Activează SyncPlay"

msgctxt "#30552"
msgid "Watch in sync with other Jellyfin clients. Leave Kodi's 'Sync playback to display' off for a reliable experience"
msgstr "Urmărește sincronizat cu alți clienți Jellyfin. Lasă Sincronizează redarea cu afișajul dezactivat în Kodi pentru o experiență fiabilă"

msgctxt "#30557"
msgid "Group notifications"
msgstr "Notificări de grup"

msgctxt "#30558"
msgid "Show member join/leave and group-waiting notifications. Errors are always shown."
msgstr "Afișează notificările de intrare/ieșire a membrilor și de așteptare a grupului. Erorile sunt afișate întotdeauna."

msgctxt "#30560"
msgid "SyncPlay"
msgstr "SyncPlay"

