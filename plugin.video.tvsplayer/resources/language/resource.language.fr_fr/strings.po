msgctxt "#30000"
msgid "TV"
msgstr "TV"

msgctxt "#30001"
msgid "Radio"
msgstr "Radio"

msgctxt "#30002"
msgid "Favourites"
msgstr "Favoris"

msgctxt "#30003"
msgid "Playlists"
msgstr "Playlists"

msgctxt "#30004"
msgid "Search"
msgstr "Rechercher"

msgctxt "#30005"
msgid "All"
msgstr "Toutes"

msgctxt "#30006"
msgid "Add M3U playlist (web address)"
msgstr "Ajouter une playlist M3U (adresse web)"

msgctxt "#30007"
msgid "Add M3U playlist (file)"
msgstr "Ajouter une playlist M3U (fichier)"

msgctxt "#30008"
msgid "Add free radio stations by country"
msgstr "Ajouter des radios gratuites par pays"

msgctxt "#30009"
msgid "Playlist address (http://… .m3u)"
msgstr "Adresse de la playlist (http://… .m3u)"

msgctxt "#30010"
msgid "Name of the playlist"
msgstr "Nom de la playlist"

msgctxt "#30011"
msgid "Content of this playlist"
msgstr "Contenu de cette playlist"

msgctxt "#30012"
msgid "Automatic (TV and radio)"
msgstr "Automatique (TV et radio)"

msgctxt "#30013"
msgid "TV only"
msgstr "TV seulement"

msgctxt "#30014"
msgid "Radio only"
msgstr "Radio seulement"

msgctxt "#30015"
msgid "Loading…"
msgstr "Chargement…"

msgctxt "#30016"
msgid "{1}: {0} channels"
msgstr "{1} : {0} chaînes"

msgctxt "#30017"
msgid "Could not load the playlist"
msgstr "Impossible de charger la playlist"

msgctxt "#30018"
msgid "Refresh"
msgstr "Actualiser"

msgctxt "#30019"
msgid "Delete"
msgstr "Supprimer"

msgctxt "#30020"
msgid "Delete \"{0}\"? Its channels are removed. Favourites stay."
msgstr "Supprimer « {0} » ? Ses chaînes sont retirées. Les favoris restent."

msgctxt "#30021"
msgid "Add to favourites"
msgstr "Ajouter aux favoris"

msgctxt "#30022"
msgid "Remove from favourites"
msgstr "Retirer des favoris"

msgctxt "#30023"
msgid "Choose link"
msgstr "Choisir le lien"

msgctxt "#30024"
msgid "Link {0}"
msgstr "Lien {0}"

msgctxt "#30025"
msgid "Channel not available (no working link)"
msgstr "Chaîne non disponible (aucun lien ne fonctionne)"

msgctxt "#30026"
msgid "No channels yet: add your M3U playlist in Playlists"
msgstr "Aucune chaîne : ajoutez votre playlist M3U dans Playlists"

msgctxt "#30027"
msgid "Radio stations of…"
msgstr "Radios de…"

msgctxt "#30028"
msgid "Load free radio stations now? (Radio Browser, an open directory)"
msgstr "Charger maintenant les radios gratuites ? (Radio Browser, un annuaire ouvert)"

msgctxt "#30029"
msgid "TVS Player does not provide any TV channels. Add only playlists you have the right to use."
msgstr "TVS Player ne fournit aucune chaîne TV. Ajoutez seulement des playlists que vous avez le droit d’utiliser."

msgctxt "#30030"
msgid "{0} channels · updated {1}"
msgstr "{0} chaînes · mise à jour {1}"

msgctxt "#30031"
msgid "Added to favourites"
msgstr "Ajouté aux favoris"

msgctxt "#30032"
msgid "Move up"
msgstr "Monter"

msgctxt "#30033"
msgid "Move down"
msgstr "Descendre"

msgctxt "#30034"
msgid "Search channels and radio"
msgstr "Rechercher chaînes et radios"

msgctxt "#30035"
msgid "never"
msgstr "jamais"

msgctxt "#30036"
msgid "Which link?"
msgstr "Quel lien ?"

msgctxt "#30038"
msgid "{0} links"
msgstr "{0} liens"

msgctxt "#30039"
msgid "No channels found: is this an M3U playlist?"
msgstr "Aucune chaîne trouvée : est-ce une playlist M3U ?"

msgctxt "#30040"
msgid "The address must start with http:// or https://"
msgstr "L’adresse doit commencer par http:// ou https://"

msgctxt "#30041"
msgid "Radio stations – {0}"
msgstr "Radios – {0}"

msgctxt "#30042"
msgid "Poor internet connection: the channel may not start"
msgstr "Connexion internet faible : la chaîne risque de ne pas démarrer"

msgctxt "#30043"
msgid "TV channels of this playlist"
msgstr "Chaînes TV de cette playlist"

msgctxt "#30044"
msgid "Radio stations of this playlist"
msgstr "Radios de cette playlist"

msgctxt "#30045"
msgid "TVS Player in the browser and on Android"
msgstr "TVS Player dans le navigateur et sur Android"

msgctxt "#30046"
msgid "Your playlists and radio also in any web browser, nothing to install: https://tvsplayer.app\nOn Android phones and tablets: TVS Player (free) and TVS Player Pro (TV guide, rewind, recordings) on Google Play."
msgstr "Vos playlists et la radio aussi dans n’importe quel navigateur, sans rien installer : https://tvsplayer.app/fr/\nSur téléphones et tablettes Android : TVS Player (gratuit) et TVS Player Pro (guide TV, retour en arrière, enregistrements) sur Google Play."

msgctxt "#30100"
msgid "General"
msgstr "Général"

msgctxt "#30101"
msgid "Check links before playing (skip dead links)"
msgstr "Vérifier les liens avant la lecture (ignorer ceux qui ne marchent pas)"

msgctxt "#30102"
msgid "Link check timeout (seconds)"
msgstr "Délai de vérification des liens (secondes)"

msgctxt "#30103"
msgid "Radio stations to load per country"
msgstr "Radios à charger par pays"

msgctxt "#30104"
msgid "First start done"
msgstr "Premier démarrage effectué"
