msgctxt "#32003"
msgid "Audio quality"
msgstr "Qualité audio"

msgctxt "#32004"
msgid "Medium — AAC-HE 64 kb/s"
msgstr "Moyenne — AAC-HE 64 kb/s"

msgctxt "#32005"
msgid "High — AAC 128 kb/s"
msgstr "Haute — AAC 128 kb/s"

msgctxt "#32006"
