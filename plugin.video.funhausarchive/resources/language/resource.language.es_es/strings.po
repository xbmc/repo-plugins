# Settings
msgctxt "#30000"
msgid "General Settings"
msgstr "Ajustes Generales"

msgctxt "#30001"
msgid "Playback & Navigation"
msgstr "Reproducción y Navegación"

msgctxt "#30002"
msgid "Playback Method"
msgstr "Método de Reproducción"

msgctxt "#30003"
msgid "Recommended: YouTube Add-on handles playback via Kodi's official YouTube plugin."
msgstr "Recomendado: El complemento de YouTube gestiona la reproducción a través del plugin oficial de YouTube de Kodi."

msgctxt "#30004"
msgid "Videos Per Page"
msgstr "Vídeos por Página"

msgctxt "#30005"
msgid "Number of videos to display per page in large video listings."
msgstr "Número de vídeos para mostrar por página en listas grandes."

msgctxt "#30006"
msgid "Remember Last Visited Page"
msgstr "Recordar Última Página Visitada"

msgctxt "#30007"
msgid "Persist pagination position across Kodi restarts and show Resume shortcuts"
msgstr "Conservar la posición de paginación tras reiniciar Kodi y mostrar accesos directos de reanudación"

msgctxt "#30008"
msgid "Maximum Video Quality"
msgstr "Calidad Máxima de Vídeo"

msgctxt "#30009"
msgid "Preferred maximum video resolution when using direct resolver"
msgstr "Resolución de vídeo máxima preferida al utilizar el extractor directo"

msgctxt "#30010"
msgid "Enable Metadata Caching"
msgstr "Activar Caché de Metadatos"

msgctxt "#30011"
msgid "Cache website scrape responses locally to speed up navigation"
msgstr "Almacenar en caché localmente las respuestas web para acelerar la navegación"

msgctxt "#30012"
msgid "Cache Expiration (Hours)"
msgstr "Caducidad de Caché (Horas)"

msgctxt "#30013"
msgid "Number of hours before refreshing cached lists"
msgstr "Número de horas antes de actualizar las listas en caché"

# Navigation Menus
msgctxt "#30100"
msgid "All Videos"
msgstr "Todos los Vídeos"

msgctxt "#30101"
msgid "Browse all 4,899+ videos with chronological and custom sorting filters."
msgstr "Explorar más de 4.899 vídeos con filtros cronológicos y personalizados."

msgctxt "#30102"
msgid "Browse by Series"
msgstr "Explorar por Series"

msgctxt "#30103"
msgid "Explore 40+ curated series (Demo Disk, Dude Soup, GTA 5, Wheelhaus, etc.)."
msgstr "Explora más de 40 series seleccionadas (Demo Disk, Dude Soup, GTA 5, Wheelhaus, etc.)."

msgctxt "#30104"
msgid "Browse by Cast"
msgstr "Explorar por Reparto"

msgctxt "#30105"
msgid "Browse videos featuring James, Bruce, Elyse, Adam, Lawrence, Jacob, and more."
msgstr "Explora vídeos con James, Bruce, Elyse, Adam, Lawrence, Jacob y más."

msgctxt "#30106"
msgid "Browse by Year"
msgstr "Explorar por Año"

msgctxt "#30107"
msgid "Browse complete archives year-by-year from 2015 to 2024."
msgstr "Explora los archivos completos año por año desde 2015 hasta 2024."

msgctxt "#30108"
msgid "Browse by Content Type"
msgstr "Explorar por Tipo de Contenido"

msgctxt "#30109"
msgid "Filter by Gameplay, Podcasts, Full Episodes, Clips, Shorts, and Compilations."
msgstr "Filtrar por Gameplays, Podcasts, Episodios Completos, Clips, Cortos y Recopilaciones."

msgctxt "#30110"
msgid "Search Videos"
msgstr "Buscar Vídeos"

msgctxt "#30111"
msgid "Search through thousands of archived Funhaus episodes by title or cast."
msgstr "Busca en miles de episodios archivados de Funhaus por título o reparto."

# Resume & Pagination
msgctxt "#30120"
msgid "Resume: {title} (Page {page} of {total})"
msgstr "Reanudar: {title} (Página {page} de {total})"

msgctxt "#30121"
msgid "Resume: {title} (Page {page})"
msgstr "Reanudar: {title} (Página {page})"

msgctxt "#30122"
msgid "Jump directly back to page {page} where you left off across Kodi restarts."
msgstr "Volver directamente a la página {page} donde lo dejaste tras reiniciar Kodi."

msgctxt "#30123"
msgid "Reset Resume Bookmark to Page 1"
msgstr "Restablecer Marcador a la Página 1"

msgctxt "#30124"
msgid "Resume bookmark reset to Page 1"
msgstr "Marcador de reanudación restablecido a la Página 1"

msgctxt "#30125"
msgid "Previous Page (Page {page} of {total})"
msgstr "Página Anterior (Página {page} de {total})"

msgctxt "#30126"
msgid "Go back to page {page}."
msgstr "Volver a la página {page}."

msgctxt "#30127"
msgid "Jump to Page... (Currently Page {page} of {total})"
msgstr "Saltar a Página... (Actualmente Página {page} de {total})"

msgctxt "#30128"
msgid "Jump directly to any page number between 1 and {total}."
msgstr "Saltar directamente a cualquier número de página entre 1 y {total}."

msgctxt "#30129"
msgid "Next Page >> (Page {page} of {total}) [Showing {start}-{end} of {total_videos}]"
msgstr "Página Siguiente >> (Página {page} de {total}) [Mostrando {start}-{end} de {total_videos}]"

msgctxt "#30130"
msgid "Proceed to page {page} of {total}."
msgstr "Avanzar a la página {page} de {total}."

msgctxt "#30131"
msgid "Jump to Page (1 - {total}):"
msgstr "Saltar a Página (1 - {total}):"

# Sort Options
msgctxt "#30140"
msgid "Oldest First (Chronological)"
msgstr "Más Antiguos Primero (Cronológico)"

msgctxt "#30141"
msgid "Oldest First (Chronological) [From Page 1]"
msgstr "Más Antiguos Primero (Cronológico) [Desde Página 1]"

msgctxt "#30142"
msgid "Watch the Funhaus archive in chronological order from February 2015 forward."
msgstr "Ver el archivo de Funhaus en orden cronológico desde febrero de 2015 en adelante."

msgctxt "#30143"
msgid "Newest First"
msgstr "Más Recientes Primero"

msgctxt "#30144"
msgid "Most recently uploaded videos first."
msgstr "Vídeos subidos más recientemente primero."

msgctxt "#30145"
msgid "Most Viewed"
msgstr "Más Vistos"

msgctxt "#30146"
msgid "Highest all-time view counts."
msgstr "Mayor número de visualizaciones de todos los tiempos."

msgctxt "#30147"
msgid "Most Liked"
msgstr "Más Me Gusta"

msgctxt "#30148"
msgid "Fan-favorite videos with the most likes."
msgstr "Vídeos favoritos de los fans con más me gusta."

msgctxt "#30149"
msgid "Longest First"
msgstr "Más Largos Primero"

msgctxt "#30150"
msgid "Longest podcasts, livestreams, and full gameplay recordings."
msgstr "Podcasts, emisiones en directo y grabaciones completas más largas."

msgctxt "#30151"
msgid "Shortest First"
msgstr "Más Cortos Primero"

msgctxt "#30152"
msgid "Quick clips, shorts, and highlights."
msgstr "Clips rápidos, cortos y momentos destacados."

msgctxt "#30153"
msgid "Title (A-Z)"
msgstr "Título (A-Z)"

msgctxt "#30154"
msgid "Alphabetical order by video title."
msgstr "Orden alfabético por título de vídeo."

msgctxt "#30155"
msgid "Title (Z-A)"
msgstr "Título (Z-A)"

msgctxt "#30156"
msgid "Reverse alphabetical order by video title."
msgstr "Orden alfabético inverso por título de vídeo."

msgctxt "#30157"
msgid "Random / Shuffle"
msgstr "Aleatorio / Mezclar"

msgctxt "#30158"
msgid "Random shuffle of the entire 4,900 video library."
msgstr "Mezcla aleatoria de toda la biblioteca de 4.900 vídeos."

# Dialogs & Notifications
msgctxt "#30160"
msgid "Search Funhaus Archive"
msgstr "Buscar en Funhaus Archive"

msgctxt "#30161"
msgid "No videos found for this selection."
msgstr "No se encontraron vídeos para esta selección."

msgctxt "#30162"
msgid "Failed to resolve video stream"
msgstr "Error al resolver la reproducción del vídeo"

