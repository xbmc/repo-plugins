msgctxt "#32003"
msgid "Before export to library, remove previous files and folders"
msgstr "Antes de exportar a la biblioteca, eliminar los archivos y carpetas anteriores"

msgctxt "#32004"
msgid "Automatically set subtitles from Dropbox"
msgstr "Usar automáticamente los subtítulos de Dropbox"

msgctxt "#32012"
msgid "Open Cloud Drive Common Settings..."
msgstr "Abrir la configuración común de Cloud Drive..."

msgctxt "#32017"
msgid "Ask to resume if resume point exists in library"
msgstr "Preguntar si se reanuda cuando hay un punto de reanudación en la biblioteca"

msgctxt "#32019"
msgid "Do not include filename extension in a .strm"
msgstr "No incluir la extensión del archivo en un .strm"

msgctxt "#32020"
msgid "Hide exporting progress dialog"
msgstr "Ocultar el progreso de la exportación"

msgctxt "#32032"
msgid "Advanced"
msgstr "Avanzado"

msgctxt "#32033"
msgid "Sign-in Server"
msgstr "Servidor de inicio de sesión"

msgctxt "#32034"
msgid "Cache expiration time (in minutes)"
msgstr "Tiempo de caducidad de la caché (en minutos)"

msgctxt "#32035"
msgid "Clear cache now"
