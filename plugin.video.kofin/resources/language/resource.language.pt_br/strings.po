msgid "Favorite movies"
msgstr "Filmes favoritos"

msgctxt "#30359"
msgid "Favorite shows"
msgstr "Séries favoritas"

msgctxt "#30360"
msgid "Favorite episodes"
msgstr "Episódios favoritos"

msgctxt "#30401"
msgid "Updating media"
msgstr "Atualizando a mídia"

msgctxt "#30403"
msgid "Sync incomplete; retrying shortly"
msgstr "Sinc. incompleta; nova tentativa"

msgctxt "#30408"
msgid "Removing library"
msgstr "Removendo a biblioteca"

msgctxt "#30415"
msgid "Connected to %s"
msgstr "Conectado a %s"

msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Conexão com o servidor perdida"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "O servidor está reiniciando"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "O servidor está desligando"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Sincronização desativada: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Pular e reproduzir a seguir"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Salto de segmentos de mídia e o aviso de Reproduzir a seguir."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Pular segmentos de mídia"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Busca os segmentos de mídia do Jellyfin (introdução, créditos, resumo, prévia, comercial) durante a reprodução e age conforme o tipo."

msgctxt "#30455"
msgid "Intros"
msgstr "Introduções"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Desativado ignora os segmentos de introdução, Automático pula por cima deles e Perguntar mostra um botão para pular."

msgctxt "#30457"
msgid "Credits"
msgstr "Créditos"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Desativado ignora os créditos, Automático avança além deles e Perguntar oferece Pular encerramento — com Reproduzir a seguir quando existe um próximo episódio."

msgctxt "#30459"
msgid "Recaps"
