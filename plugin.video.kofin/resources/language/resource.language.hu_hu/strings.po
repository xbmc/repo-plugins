msgstr "1440p"

msgctxt "#30613"
msgid "Audio and subtitle streams"
msgstr "Hang- és feliratsávok"

msgctxt "#30614"
msgid "Audio stream"
msgstr "Hangsáv"

msgctxt "#30615"
msgid "Subtitles"
msgstr "Feliratok"

msgctxt "#30616"
msgid "Restarting to change stream..."
msgstr "Újraindítás a sáv váltásához…"

msgctxt "#30617"
msgid "burned in, restarts playback"
msgstr "ráégetett, újraindítja a lejátszást"

msgctxt "#30618"
msgid "Use Jellyfin's default tracks"
msgstr "A Jellyfin alapértelmezett sávjainak használata"

msgctxt "#30619"
msgid "Start playback on the audio and subtitle tracks your Jellyfin account asks for, instead of the ones Kodi's own language settings pick. The server resolves both from your Jellyfin profile, so the choice follows you to every client."
msgstr "A lejátszás azokon a hang- és feliratsávokon induljon, amelyeket a Jellyfin-fiókja kér, a Kodi saját nyelvi beállításai által választottak helyett. A kiszolgáló mindkettőt a Jellyfin-profilja alapján oldja fel, így a választás minden kliensre elkíséri."

msgctxt "#30622"
msgid "Notify about new content"
msgstr "Értesítés az új tartalomról"

msgctxt "#30623"
msgid "Show a notification when new films, shows, episodes, music videos, artists or albums are added to your library."
msgstr "Értesítés megjelenítése, amikor új film, sorozat, epizód, videóklip, előadó vagy album kerül a médiatárba."

