msgctxt "#32000"
msgid "Player Service"
msgstr "Uppspelningstjänst"

msgctxt "#32001"
msgid "Export Service"
msgstr "Exporttjänst"

msgctxt "#32002"
msgid "Source Service"
msgstr "Källtjänst"

msgctxt "#32003"
msgid "Before full export, remove previous local files and folders"
msgstr "Innan fullständig export, ta bort tidigare lokala filer och mappar"

msgctxt "#32004"
msgid "Automatically set subtitles from cloud drive"
msgstr "Ställ automatiskt in undertexter från molnlagringen"

msgctxt "#32005"
msgid "Auto-Refreshed slideshow"
msgstr "Automatiskt uppdaterat bildspel"

msgctxt "#32006"
msgid "Refresh interval in minutes"
msgstr "Uppdateringsintervall i minuter"

msgctxt "#32007"
msgid "Google Photos"
msgstr "Google Foto"

msgctxt "#32010"
msgid "Recursive auto-refreshed slideshow"
msgstr "Rekursivt bildspel med automatisk uppdatering"

msgctxt "#32012"
msgid "Open Cloud Drive Common Settings..."
msgstr "Öppna gemensamma inställningar för Cloud Drive..."

msgctxt "#32013"
msgid "My Drive"
msgstr "Min enhet"

msgctxt "#32014"
msgid "Starred"
msgstr "Stjärnmärkt"

