msgstr "Nyligen tillagda avsnitt"

msgctxt "#30356"
msgid "In progress episodes"
msgstr "Påbörjade avsnitt"

msgctxt "#30358"
msgid "Favorite movies"
msgstr "Favoritfilmer"

msgctxt "#30359"
msgid "Favorite shows"
msgstr "Favoritserier"

msgctxt "#30360"
msgid "Favorite episodes"
msgstr "Favoritavsnitt"

msgctxt "#30401"
msgid "Updating media"
msgstr "Uppdaterar media"

msgctxt "#30403"
msgid "Sync incomplete; retrying shortly"
msgstr "Synk ofullständig, försöker igen"

msgctxt "#30408"
msgid "Removing library"
msgstr "Tar bort bibliotek"

msgctxt "#30415"
msgid "Connected to %s"
msgstr "Ansluten till %s"

msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Tappade anslutningen till servern"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "Servern startar om"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "Servern stängs av"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Bibliotekssynk är av: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Hoppa över och spela nästa"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Överhoppning av mediesegment och frågan Spela nästa."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Hoppa över mediesegment"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Hämta Jellyfins mediesegment (intro, eftertexter, sammanfattning, förhandsvisning, reklam) under uppspelning och agera på dem per typ."

msgctxt "#30455"
msgid "Intros"
msgstr "Intron"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Av ignorerar introsegment, Auto hoppar över dem, Fråga visar en hoppa över-knapp."

msgctxt "#30457"
msgid "Credits"
msgstr "Eftertexter"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Av ignorerar eftertexter, Auto spolar förbi dem, Fråga erbjuder Hoppa över eftertexter — med Spela nästa när det finns ett nästa avsnitt."

msgctxt "#30459"
msgid "Recaps"
msgstr "Sammanfattningar"

msgctxt "#30460"
msgid "Off ignores recap segments, Auto skips past them, Ask shows a skip button."
