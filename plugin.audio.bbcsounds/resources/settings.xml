<?xml version="1.0" ?>
<settings version="1">
	<section id="plugin.video.bbcsounds">
		<category id="account" label="30100" help="">
            <group id="grp1-1">
				<setting id="account-sign-in-passw" label="30101" type="action" help="30102">
					<level>0</level>
					<data>RunPlugin(plugin://$ID/account/login_with_passw)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
				</setting>
				<setting id="account-sign-in-email" label="30103" type="action" help="30104">
					<level>0</level>
					<data>RunPlugin(plugin://$ID/account/login_with_email_link)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
				</setting>
				<setting id="account-sign-out" label="30105" type="action" help="">
					<level>0</level>
					<data>RunPlugin(plugin://$ID/account/log_out)</data>
					<control type="button" format="action" />
				</setting>
                <setting id="is-signed-in" label="" type="boolean" help="">
					<default>false</default>
					<visible>false</visible>
					<control type="toggle"/>
				</setting>
			</group>
        </category>
