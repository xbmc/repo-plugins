msgctxt "#30041"
msgid "Who's watching?"
msgstr "誰が視聴中？"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "サーバーにアクティブなセッションがまだありません"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "誰が視聴中？（%s）"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "%s と誰が一緒に視聴中？"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "セッションに追加できるユーザー"

msgctxt "#30250"
msgid "Library"
msgstr "ライブラリ"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Kodi のデータベースに取り込む Jellyfin ライブラリを選択し、管理します。"

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "同期するライブラリを選択"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Kodi のライブラリに取り込むサーバーのライブラリを選びます。選択を確定すると変更が適用されます。"

msgctxt "#30256"
msgid "Update libraries"
msgstr "ライブラリを更新"

msgctxt "#30258"
msgid "Repair libraries"
msgstr "ライブラリを修復"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "選んだライブラリを削除して最初から同期し直し、視聴済みの状態をサーバーから復元します。選択を確定すると実行されます。"

msgctxt "#30262"
msgid "Sync status"
msgstr "同期の状態"

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "同期したライブラリを削除しますか？"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "%s を Kodi のライブラリから削除しますか？アイテムはこのデバイスからのみ削除されます。"

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "どのライブラリを修復しますか？"

msgctxt "#30267"
msgid "All"
msgstr "すべて"

msgctxt "#30268"
msgid "Select libraries"
msgstr "ライブラリを選択"

msgctxt "#30269"
msgid "No libraries available"
msgstr "利用できるライブラリがありません"

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "更新状況を非表示にする件数"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "これより少ない件数の同期では、Kodi のライブラリ更新の進行状況を表示しません。0 にすると常に表示します。"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "アートワークを圧縮する"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "解像度を制限したアートワークを JPEG 品質 90 で再エンコードします。解像度の上限がない場合は効果がありません。"

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "アートワークの最大解像度"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "同期するアートワークの高さを制限します。「オリジナル」はサーバー上のサイズのままにします。"

msgctxt "#30322"
msgid "Original"
msgstr "オリジナル"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

msgctxt "#30325"
msgid "2160p"
msgstr "2160p"

msgctxt "#30326"
msgid "Notify on server connection changes"
msgstr "サーバー接続の変化を通知する"

msgctxt "#30327"
msgid "Show a notification when the server connects, disconnects or restarts."
msgstr "サーバーへの接続、切断、サーバーの再起動時に通知を表示します。"

msgctxt "#30350"
msgid "Recently added"
msgstr "最近追加"

msgctxt "#30351"
msgid "In progress"
msgstr "視聴中"

