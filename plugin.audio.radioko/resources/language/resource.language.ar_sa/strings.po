msgctxt "#30000"
msgid "Search all countries"
msgstr "البحث في كل البلدان"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "اسم المحطة أو المدينة أو التصنيف"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "لا توجد محطة تطابق «{q}»."

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "يتعذر تشغيل هذا البث حاليًا."

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "تعذّر الوصول إلى radioko الآن."

msgctxt "#30005"
msgid "Loading all countries…"
msgstr "جارٍ تحميل كل البلدان…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "اختر بلدًا"

msgctxt "#30007"
msgid "This station's stream can only be heard in its own country: {country}."
msgstr "لا يمكن الاستماع إلى بث هذه المحطة إلا داخل بلدها: {country}."

msgctxt "#30008"
msgid "Search"
msgstr "بحث"
