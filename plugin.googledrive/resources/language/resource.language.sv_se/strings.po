msgid "Hide exporting progress dialog"
msgstr "Dölj dialogrutan för exportförlopp"

msgctxt "#32032"
msgid "Advanced"
msgstr "Avancerat"

msgctxt "#32033"
msgid "Sign-in Server"
msgstr "Inloggningsserver"

msgctxt "#32034"
msgid "Cache expiration time (in minutes)"
msgstr "Utgångstid för cachen (i minuter)"

msgctxt "#32035"
msgid "Clear cache now"
msgstr "Töm cachen nu"

msgctxt "#32067"
msgid "Services"
msgstr "Tjänster"

msgctxt "#32068"
msgid "Allow using Google Drive as a source"
msgstr "Tillåt användning av Google Drive som källa"

msgctxt "#32069"
msgid "     Source server port  -  http://localhost:<port>/source"
msgstr "     Port för källservern  -  http://localhost:<port>/source"

msgctxt "#32071"
msgid "Check download quota"
msgstr "Kontrollera nedladdningskvot"

