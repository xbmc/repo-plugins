msgctxt "#30000"
msgid "Search all countries"
msgstr "Претражи све земље"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "Назив станице, град или жанр"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "Ниједна станица не одговара упиту „{q}“."

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "Овај стрим тренутно не ради."

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "radioko тренутно није доступан."

msgctxt "#30005"
msgid "Loading all countries…"
msgstr "Учитавање свих земаља…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "Изабери земљу"

msgctxt "#30007"
msgid "This station's stream can only be heard in its own country: {country}."
msgstr "Стрим ове станице може да се слуша само у њеној земљи: {country}."

msgctxt "#30008"
msgid "Search"
msgstr "Претрага"
