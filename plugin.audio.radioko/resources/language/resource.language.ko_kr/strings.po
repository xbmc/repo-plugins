msgctxt "#30000"
msgid "Search all countries"
msgstr "모든 국가에서 검색"

msgctxt "#30001"
msgid "Station name, city or genre"
msgstr "방송국 이름, 도시 또는 장르"

msgctxt "#30002"
msgid "No station matches “{q}”."
msgstr "“{q}” 검색 결과가 없어요."

msgctxt "#30003"
msgid "This stream isn't playing right now."
msgstr "지금은 이 방송을 재생할 수 없어요."

msgctxt "#30004"
msgid "radioko cannot be reached right now."
msgstr "지금은 radioko에 연결할 수 없어요."

msgctxt "#30005"
msgid "Loading all countries…"
msgstr "모든 국가를 불러오는 중…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "국가 선택"

msgctxt "#30007"
msgid "This station's stream can only be heard in its own country: {country}."
msgstr "이 방송국의 스트림은 방송국이 있는 나라에서만 들을 수 있어요: {country}."

msgctxt "#30008"
msgid "Search"
msgstr "검색"
