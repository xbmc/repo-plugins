msgid "Favorite movies"
msgstr "Películas favoritas"

msgctxt "#30359"
msgid "Favorite shows"
msgstr "Series favoritas"

msgctxt "#30360"
msgid "Favorite episodes"
msgstr "Episodios favoritos"

