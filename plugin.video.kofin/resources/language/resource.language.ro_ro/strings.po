msgstr "Sincronizare oprită: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Omitere și redarea următorului"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Omiterea segmentelor media și solicitarea Redă următorul."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Omite segmentele media"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Preia segmentele media Jellyfin (intro, generic, rezumat, previzualizare, reclamă) în timpul redării și acționează în funcție de tip."

msgctxt "#30455"
msgid "Intros"
msgstr "Intro-uri"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Dezactivat ignoră segmentele de intro, Auto trece peste ele, Întreabă afișează un buton de omitere."

msgctxt "#30457"
msgid "Credits"
msgstr "Generic"

