msgstr "Đang tải tất cả quốc gia…"

msgctxt "#30006"
msgid "Choose a country"
msgstr "Chọn quốc gia"

msgctxt "#30007"
msgid "This station's stream can only be heard in its own country: {country}."
msgstr "Luồng phát của đài này chỉ nghe được tại quốc gia của đài: {country}."

msgctxt "#30008"
msgid "Search"
msgstr "Tìm kiếm"
