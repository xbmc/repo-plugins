msgstr "Новая группа..."

msgctxt "#30562"
msgid "Leave group"
msgstr "Покинуть группу"

msgctxt "#30563"
msgid "Joined group: %s"
msgstr "Вход в группу: %s"

msgctxt "#30564"
msgid "Left the group"
msgstr "Группа покинута"

msgctxt "#30565"
msgid "%s joined the group"
msgstr "%s вошёл в группу"

msgctxt "#30566"
msgid "%s left the group"
msgstr "%s покинул группу"

msgctxt "#30567"
msgid "Group name"
msgstr "Название группы"

msgctxt "#30568"
msgid "Playback stopped — what should the group do?"
msgstr "Воспроизведение остановлено — что делать группе?"

msgctxt "#30569"
msgid "Spectator mode: the group will not wait for you"
msgstr "Режим наблюдателя: группа не будет вас ждать"

msgctxt "#30570"
msgid "SyncPlay needs a working websocket connection to the server"
msgstr "Для SyncPlay нужно рабочее соединение websocket с сервером"

msgctxt "#30571"
msgid "Removed from the group"
msgstr "Вас удалили из группы"

